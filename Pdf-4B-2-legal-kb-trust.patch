+    const text = m2.statements.join("\n");
+    expect(text).not.toMatch(/\bDROP\b|\bALTER\b|\bTRUNCATE TABLE\b|\bpublic\./i);
+    for (const s of m2.statements) expect(s.trim(), s).toMatch(/^CREATE (SCHEMA|TABLE|INDEX|FUNCTION|TRIGGER)\b/);
