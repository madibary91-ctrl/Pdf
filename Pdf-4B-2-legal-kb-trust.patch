+
+    it("پایگاه در وضعیت ۰۰۰۱: همهٔ کنش‌ها NOT_MIGRATED؛ migrate() فقط ۰۰۰۲ را اعمال می‌کند و داده سالم می‌ماند", async () => {
+      const kb = await fresh();
