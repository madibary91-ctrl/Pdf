+    expect(versionContentHash({ text: "می\u200cخواهم", subparts: [] })).not.toBe(versionContentHash({ text: "می خواهم", subparts: [] }));
+    expect(versionContentHash({ text: "é", subparts: [] })).not.toBe(versionContentHash({ text: "e\u0301", subparts: [] }));
