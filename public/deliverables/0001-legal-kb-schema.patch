index 0000000..9ab4157
--- /dev/null
+++ b/src/modules/legal-kb-schema/label.test.ts
@@ -0,0 +1,235 @@
+import { describe, expect, it } from "vitest";
+import { isValidIsoDate, parseIsoDate } from "./dates";
+import {
+  articleKey,
+  canonicalArticleLabel,
+  canonicalSubpartLabel,
+  compareArticleLabels,
+  formatArticleLabel,
+  formatCitationKey,
+  isValidDocumentId,
+  parseArticleKey,
+  parseArticleLabel,
+  parseCitationKey,
+  type ArticleLabel,
+} from "./label";
+
+const canon = (s: string) => {
+  const r = canonicalArticleLabel(s);
+  return r.ok ? r.value : `ERR:${r.error.code}`;
+};
+
+/** مولد شبه‌تصادفی قطعی (LCG)؛ تست‌ها باید تکرارپذیر باشند. */
+function lcg(seed: number) {
+  let s = seed >>> 0;
+  return (n: number) => {
+    s = (Math.imul(s, 1664525) + 1013904223) >>> 0;
+    return s % n;
+  };
+}
+
+describe("برچسب ماده: نرمال‌سازی به شکل متعارف", () => {
+  it("ارقام فارسی، عربی و لاتین یکی‌اند", () => {
+    expect(canon("۱۰")).toBe("10");
+    expect(canon("١٠")).toBe("10");
+    expect(canon("10")).toBe("10");
+    expect(canon("۰۱۰")).toBe("10"); // صفر پیشرو
+  });
+
+  it("پیشوند «ماده»/«اصل» و فاصله‌ها", () => {
+    expect(canon("ماده ۱۰")).toBe("10");
+    expect(canon("اصل ۴۴")).toBe("44");
+    expect(canon("  ماده   ۱۰  ")).toBe("10");
+    expect(canon("ماده\u200C۱۰")).toBe("10"); // نیم‌فاصله
+  });
+
+  it("مکرر (با ک/ی عربی و کشیده)", () => {
+    expect(canon("10 مکرر")).toBe("10 مکرر");
+    expect(canon("۱۰ مكرر")).toBe("10 مکرر");
+    expect(canon("ماده ۱۰ مکـــرر")).toBe("10 مکرر");
+    expect(canon("10 مکرر 2")).toBe("10 مکرر 2");
+    expect(canon("۱۰ مکرر ۲")).toBe("10 مکرر 2");
+    expect(canon("10 مکرر 99")).toBe("10 مکرر 99");
+  });
+
+  it("واحده", () => {
+    expect(canon("واحده")).toBe("واحده");
+    expect(canon("ماده واحده")).toBe("واحده");
+    expect(canon("ماده‌واحده")).toBe("واحده");
+  });
+
+  it("مرزها: ۱ و ۹۹۹۹۹ مجازند؛ ۰ و ۱۰۰۰۰۰ نه", () => {
+    expect(canon("1")).toBe("1");
+    expect(canon("99999")).toBe("99999");
+    expect(canon("0")).toBe("ERR:OUT_OF_RANGE");
+    expect(canon("100000")).toBe("ERR:INVALID_INPUT"); // ۶ رقم: الگو نمی‌خورد
+  });
+
+  it("شکل‌های مبهم یا ناشناخته = خطای صریح، نه حدس", () => {
+    for (const bad of ["", "   ", "ماده", "abc", "10 bis", "10مکرر", "10 مکرر 1", "10 مکرر 100", "-5", "1.5", "1e3", "10 مکرر مکرر", "ماده ماده 10", "10 مکرر x", "مکرر 10"]) {
+      expect(canon(bad).startsWith("ERR:"), bad).toBe(true);
+    }
+    expect(canon("10 مکرر 1")).toBe("ERR:OUT_OF_RANGE");
+    expect(canon("10 مکرر 0")).toBe("ERR:OUT_OF_RANGE");
+    expect(canon(5 as unknown as string)).toBe("ERR:INVALID_INPUT");
+  });
+
+  it("چند صفر پیشرو و رقم‌های مخلوط", () => {
+    expect(canon("۰۰۰۰۷")).toBe("7");
+    expect(canon("1۰")).toBe("10");
+  });
+});
+
+describe("برچسب ماده: رفت‌وبرگشت و ترتیب (خاصیت)", () => {
+  it("۲۰۰۰ برچسب تصادفی: format↔parse و key↔parseKey پایدارند", () => {
+    const rnd = lcg(7);
+    for (let i = 0; i < 2000; i++) {
+      const label: ArticleLabel =
+        rnd(10) === 0
+          ? { kind: "single" }
+          : { kind: "numbered", number: 1 + rnd(99999), repeat: rnd(3) === 0 ? 0 : rnd(2) === 0 ? 1 : 2 + rnd(98) };
+      const text = formatArticleLabel(label);
+      const back = parseArticleLabel(text);
+      expect(back.ok && back.value).toEqual(label);
+      const key = articleKey(label);
+      const back2 = parseArticleKey(key);
+      expect(back2.ok && back2.value).toEqual(label);
+      expect(/^[a-z0-9-]+$/.test(key)).toBe(true);
+    }
+  });
+
+  it("کلید یکتاست: دو برچسب متفاوت کلید یکسان ندارند", () => {
+    const rnd = lcg(11);
+    const seen = new Map<string, string>();
+    for (let i = 0; i < 3000; i++) {
+      const label: ArticleLabel = { kind: "numbered", number: 1 + rnd(40), repeat: rnd(4) };
+      const k = articleKey(label);
+      const f = formatArticleLabel(label);
+      if (seen.has(k)) expect(seen.get(k)).toBe(f);
+      seen.set(k, f);
+    }
+  });
+
+  it("ترتیب طبیعی: واحده < شماره < مکرر < مکرر ۲ < شمارهٔ بعد", () => {
+    const labels = ["11", "10 مکرر 2", "واحده", "10", "2", "10 مکرر", "1"];
+    const sorted = labels
+      .map((l) => parseArticleLabel(l))
+      .map((r) => (r.ok ? r.value : (null as never)))
+      .sort(compareArticleLabels)
+      .map(formatArticleLabel);
+    expect(sorted).toEqual(["واحده", "1", "2", "10", "10 مکرر", "10 مکرر 2", "11"]);
+  });
+
+  it("کلید غیرمتعارف رد می‌شود (برای هر ماده فقط یک کلید)", () => {
+    for (const bad of ["007", "10-bis-1", "10-bis-02", "10-bis-100", "10-BIS", "0", "10-bis-", "bis", "10 ", "-10", "single2"]) {
+      expect(parseArticleKey(bad).ok, bad).toBe(false);
+    }
+    expect(parseArticleKey(3 as unknown as string).ok).toBe(false);
+  });
+});
+
+describe("برچسب تبصره/بند", () => {
+  it("عدد و حروف فارسی", () => {
+    const f = (s: string) => {
+      const r = canonicalSubpartLabel(s);
+      return r.ok ? r.value : `ERR:${r.error.code}`;
+    };
+    expect(f("۲")).toBe("2");
+    expect(f("02")).toBe("2");
+    expect(f("٣")).toBe("3");
+    expect(f("الف")).toBe("الف");
+    expect(f(" ب ")).toBe("ب");
+    expect(f("ك")).toBe("ک"); // ک عربی
+    expect(f("0")).toBe("ERR:OUT_OF_RANGE");
+    expect(f("0000")).toBe("ERR:INVALID_INPUT");
+    expect(f("1000")).toBe("ERR:INVALID_INPUT");
+    expect(f("999")).toBe("999");
+    expect(f("a")).toBe("ERR:INVALID_INPUT");
+    expect(f("")).toBe("ERR:INVALID_INPUT");
+    expect(f("الف ب")).toBe("ERR:INVALID_INPUT");
+    expect(f("الفباپتثج")).toBe("ERR:INVALID_INPUT"); // ۸ حرف
+    expect(f(1 as unknown as string)).toBe("ERR:INVALID_INPUT");
+  });
+});
+
+describe("شناسهٔ سند", () => {
+  it("قالب و طول", () => {
+    expect(isValidDocumentId("sample-law")).toBe(true);
+    expect(isValidDocumentId("a")).toBe(true);
+    expect(isValidDocumentId("a".repeat(64))).toBe(true);
+    expect(isValidDocumentId("a".repeat(65))).toBe(false);
+    for (const bad of ["", "-a", "a-", "a--b", "A", "a_b", "a/b", "قانون", "a b", "a.b", "../x"]) expect(isValidDocumentId(bad), bad).toBe(false);
+    expect(isValidDocumentId(5)).toBe(false);
+    expect(isValidDocumentId(null)).toBe(false);
+  });
+});
+
+describe("کلید ارجاع", () => {
+  it("رفت‌وبرگشت با و بدون بخش", () => {
+    const refs = [
+      { documentId: "sample-law", article: "10", subpart: null },
+      { documentId: "sample-law", article: "10 مکرر", subpart: null },
+      { documentId: "x1", article: "10 مکرر 3", subpart: { kind: "note" as const, label: "2" } },
+      { documentId: "x1", article: "واحده", subpart: { kind: "clause" as const, label: "الف" } },
+    ];
+    const keys = refs.map((r) => {
+      const k = formatCitationKey(r);
+      return k.ok ? k.value : "ERR";
+    });
+    expect(keys).toEqual(["sample-law/10", "sample-law/10-bis", "x1/10-bis-3/note/2", "x1/single/clause/الف"]);
+    keys.forEach((k, i) => {
+      const back = parseCitationKey(k);
+      expect(back.ok && back.value).toEqual(refs[i]);
+    });
+  });
+
+  it("ورودی انسانی به شکل متعارف تبدیل می‌شود", () => {
+    const k = formatCitationKey({ documentId: "a", article: "ماده ۱۰ مکرر", subpart: { kind: "note", label: "۲" } });
+    expect(k.ok && k.value).toBe("a/10-bis/note/2");
+  });
+
+  it("کلید نامعتبر", () => {
+    for (const bad of ["", "a", "a/b/c", "a/10/foo/1", "A/10", "a/10/note/02", "a/10/note/x", "a/10/note/", "a/007", "a/10/note/1/extra", "/10"]) {
+      expect(parseCitationKey(bad).ok, bad).toBe(false);
+    }
+    expect(parseCitationKey(1 as unknown as string).ok).toBe(false);
+    expect(formatCitationKey({ documentId: "BAD", article: "1", subpart: null }).ok).toBe(false);
+    expect(formatCitationKey({ documentId: "a", article: "zz", subpart: null }).ok).toBe(false);
+    expect(formatCitationKey({ documentId: "a", article: "1", subpart: { kind: "foo" as "note", label: "1" } }).ok).toBe(false);
+    expect(formatCitationKey({ documentId: "a", article: "1", subpart: { kind: "note", label: "x" } }).ok).toBe(false);
+  });
+});
+
+describe("تاریخ میلادی ISO", () => {
+  it("کبیسه‌ها (قاعدهٔ ۴/۱۰۰/۴۰۰)", () => {
+    expect(isValidIsoDate("2000-02-29")).toBe(true);
+    expect(isValidIsoDate("2024-02-29")).toBe(true);
+    expect(isValidIsoDate("1900-02-29")).toBe(false);
+    expect(isValidIsoDate("2100-02-29")).toBe(false);
+    expect(isValidIsoDate("2023-02-29")).toBe(false);
+    expect(isValidIsoDate("2023-02-28")).toBe(true);
+  });
+
+  it("طول ماه‌ها و قالب", () => {
+    expect(isValidIsoDate("2024-04-30")).toBe(true);
+    expect(isValidIsoDate("2024-04-31")).toBe(false);
+    expect(isValidIsoDate("2024-12-31")).toBe(true);
+    for (const bad of ["2024-13-01", "2024-00-10", "2024-01-00", "2024-1-01", "2024-01-1", " 2024-01-01", "2024-01-01 ", "2024-01-01T00:00:00Z", "20240101", "۲۰۲۴-۰۱-۰۱", "", "2024/01/01"]) {
+      expect(isValidIsoDate(bad), bad).toBe(false);
+    }
+    expect(isValidIsoDate(20240101)).toBe(false);
+    expect(isValidIsoDate(null)).toBe(false);
+  });
+
+  it("حدود سال: ۱۸۰۰ تا ۲۲۰۰؛ تاریخ جلالی (۱۴۰۳) به‌اشتباه به‌جای میلادی رد می‌شود", () => {
+    expect(isValidIsoDate("1799-12-31")).toBe(false);
+    expect(isValidIsoDate("1800-01-01")).toBe(true);
+    expect(isValidIsoDate("2200-12-31")).toBe(true);
+    expect(isValidIsoDate("2201-01-01")).toBe(false);
+    expect(isValidIsoDate("1403-01-01")).toBe(false);
+    const r = parseIsoDate("1403-01-01");
+    expect(!r.ok && r.error.code).toBe("INVALID_DATE");
+    const r2 = parseIsoDate(5);
+    expect(!r2.ok && r2.error.code).toBe("INVALID_DATE");
+  });
+});
diff --git a/src/modules/legal-kb-schema/label.ts b/src/modules/legal-kb-schema/label.ts
new file mode 100644
index 0000000..f216088
--- /dev/null
+++ b/src/modules/legal-kb-schema/label.ts
@@ -0,0 +1,180 @@
+/**
+ * برچسب ماده، برچسب تبصره/بند، شناسهٔ سند و کلید ارجاع — نرمال‌سازی و قالب متعارف.
+ *
+ * چرا نرمال‌سازی خودش را دارد؟ registry این ماژول را فقط به shared-types وابسته کرده (persian-text مجاز نیست)؛
+ * نیاز اینجا کوچک و بسته است (ارقام، ی/ک، نیم‌فاصله) و تست‌های جداگانه دارد.
+ *
+ * شکل‌های ماده که می‌پذیریم (همه‌چیز دیگر = خطای صریح، نه حدس):
+ *   `10` · `10 مکرر` · `10 مکرر 2` · `واحده` ،  با پیشوند اختیاری «ماده»/«اصل» و ارقام فارسی/عربی/لاتین.
+ * «مکرر ۲» یک امکان فنی است (شمارندهٔ دوم)؛ وجودش در قانون واقعی یکی از پرسش‌های باز برای حقوقدان است (ADR-0003).
+ */
+import { err, ok, type Result } from "@/modules/shared-types";
+import type { CitationRef, SubpartKind } from "./types";
+import { SUBPART_KINDS } from "./types";
+
+export type ArticleLabel =
+  | Readonly<{ kind: "numbered"; number: number; /** ۰ = بدون «مکرر»، ۱ = «مکرر»، n≥۲ = «مکرر n» */ repeat: number }>
+  | Readonly<{ kind: "single" }>;
+
+export const MAX_ARTICLE_NUMBER = 99999;
+export const MAX_REPEAT = 99;
+const REPEAT_WORD = "مکرر";
+
+const PERSIAN_DIGITS = "۰۱۲۳۴۵۶۷۸۹";
+const ARABIC_DIGITS = "٠١٢٣٤٥٦٧٨٩";
+
+/** ارقام فارسی/عربی → لاتین، ی/ک عربی → فارسی، حذف کشیده و نویسه‌های نامرئی، نیم‌فاصله و فاصله‌های خاص → فاصلهٔ ساده. */
+export function normalizeLabelText(input: string): string {
+  let out = "";
+  for (const ch of input) {
+    const p = PERSIAN_DIGITS.indexOf(ch);
+    if (p >= 0) out += String(p);
+    else {
+      const a = ARABIC_DIGITS.indexOf(ch);
+      if (a >= 0) out += String(a);
+      else if (ch === "ي" || ch === "ى") out += "ی";
+      else if (ch === "ك") out += "ک";
+      else if (ch === "\u0640" || ch === "\u200E" || ch === "\u200F" || ch === "\u200B" || ch === "\uFEFF") out += "";
+      else if (/\s/.test(ch) || ch === "\u200C" || ch === "\u00A0") out += " ";
+      else out += ch;
+    }
+  }
+  return out.replace(/ +/g, " ").trim();
+}
+
+const ARTICLE_RE = new RegExp(`^(?:(?:ماده|اصل) )?(?:(\\d{1,5})(?: ${REPEAT_WORD}(?: (\\d{1,2}))?)?|واحده)$`);
+
+export function parseArticleLabel(input: string): Result<ArticleLabel> {
+  if (typeof input !== "string") return err("INVALID_INPUT", "برچسب ماده باید متن باشد.");
+  const s = normalizeLabelText(input);
+  if (s === "") return err("INVALID_INPUT", "برچسب ماده خالی است.");
+  const m = ARTICLE_RE.exec(s);
+  if (!m) {
+    return err("INVALID_INPUT", `برچسب ماده «${input}» شناخته نشد؛ شکل‌های پذیرفته: «۱۰»، «۱۰ مکرر»، «۱۰ مکرر ۲»، «واحده».`);
+  }
+  if (m[1] === undefined) return ok({ kind: "single" });
+  const number = Number(m[1]);
+  if (number < 1 || number > MAX_ARTICLE_NUMBER) {
+    return err("OUT_OF_RANGE", `شمارهٔ ماده باید از ۱ تا ${MAX_ARTICLE_NUMBER} باشد.`);
+  }
+  const hasRepeat = s.includes(` ${REPEAT_WORD}`);
+  let repeat = 0;
+  if (hasRepeat) {
+    if (m[2] === undefined) repeat = 1;
+    else {
+      repeat = Number(m[2]);
+      // «مکرر ۱» با «مکرر» یکی است و دو شکل برای یک چیز نمی‌پذیریم؛ «مکرر ۰» بی‌معنی است.
+      if (repeat < 2 || repeat > MAX_REPEAT) return err("OUT_OF_RANGE", `شمارندهٔ «مکرر» باید از ۲ تا ${MAX_REPEAT} باشد (برای حالت اول فقط «مکرر» بنویسید).`);
+    }
+  }
+  return ok({ kind: "numbered", number, repeat });
+}
+
+/** شکل متعارف برای ذخیره و مقایسه: `10`، `10 مکرر`، `10 مکرر 2`، `واحده`. */
+export function formatArticleLabel(label: ArticleLabel): string {
+  if (label.kind === "single") return "واحده";
+  if (label.repeat === 0) return String(label.number);
+  if (label.repeat === 1) return `${label.number} ${REPEAT_WORD}`;
+  return `${label.number} ${REPEAT_WORD} ${label.repeat}`;
+}
+
+export function canonicalArticleLabel(input: string): Result<string> {
+  const r = parseArticleLabel(input);
+  return r.ok ? ok(formatArticleLabel(r.value)) : r;
+}
+
+/** ترتیب طبیعی: «واحده» پیش از همه؛ سپس شماره؛ سپس بدون‌مکرر < مکرر < مکرر ۲ … */
+export function compareArticleLabels(a: ArticleLabel, b: ArticleLabel): number {
+  if (a.kind === "single") return b.kind === "single" ? 0 : -1;
+  if (b.kind === "single") return 1;
+  return a.number - b.number || a.repeat - b.repeat;
+}
+
+/** کلید ASCII برای ذخیره/نشانی: `10`، `10-bis`، `10-bis-2`، `single`. */
+export function articleKey(label: ArticleLabel): string {
+  if (label.kind === "single") return "single";
+  if (label.repeat === 0) return String(label.number);
+  if (label.repeat === 1) return `${label.number}-bis`;
+  return `${label.number}-bis-${label.repeat}`;
+}
+
+export function parseArticleKey(key: string): Result<ArticleLabel> {
+  if (typeof key !== "string") return err("INVALID_INPUT", "کلید ماده باید متن باشد.");
+  if (key === "single") return ok({ kind: "single" });
+  const m = /^(\d{1,5})(?:-bis(?:-(\d{1,2}))?)?$/.exec(key);
+  if (!m) return err("INVALID_INPUT", `کلید ماده «${key}» معتبر نیست.`);
+  const number = Number(m[1]);
+  if (number < 1 || number > MAX_ARTICLE_NUMBER) return err("OUT_OF_RANGE", "شمارهٔ ماده خارج از حد است.");
+  const repeat = key.indexOf("-bis") < 0 ? 0 : m[2] === undefined ? 1 : Number(m[2]);
+  if (repeat > MAX_REPEAT || (m[2] !== undefined && repeat < 2)) return err("OUT_OF_RANGE", "شمارندهٔ «مکرر» خارج از حد است.");
+  // قالب متعارف: بدون صفر پیشرو (`07` رد می‌شود تا یک ماده دو کلید نداشته باشد)
+  if (articleKey({ kind: "numbered", number, repeat }) !== key) return err("INVALID_INPUT", `کلید ماده «${key}» متعارف نیست.`);
+  return ok({ kind: "numbered", number, repeat });
+}
+
+// ───────────── تبصره / بند ─────────────
+
+/** حروف مجاز برچسب بند (الف، ب، پ، ت …). عمداً فهرست صریح، نه بازه (بازهٔ یونیکد ارقام عربی را هم می‌گیرد). */
+const LABEL_LETTERS = "آابپتثجچحخدذرزژسشصضطظعغفقکگلمنوهی";
+const SUBPART_LABEL_RE = new RegExp(`^(?:\\d{1,3}|[${LABEL_LETTERS}]{1,6})$`);
+
+export function canonicalSubpartLabel(input: string): Result<string> {
+  if (typeof input !== "string") return err("INVALID_INPUT", "برچسب تبصره/بند باید متن باشد.");
+  const s = normalizeLabelText(input);
+  if (!SUBPART_LABEL_RE.test(s)) {
+    return err("INVALID_INPUT", `برچسب تبصره/بند «${input}» شناخته نشد؛ فقط عدد (حداکثر ۳ رقم) یا حروف فارسی (مثل «الف»).`);
+  }
+  if (/^\d+$/.test(s)) {
+    const n = Number(s);
+    if (n < 1) return err("OUT_OF_RANGE", "شمارهٔ تبصره/بند باید از ۱ باشد.");
+    return ok(String(n)); // «۰۲» → «2»
+  }
+  return ok(s);
+}
+
+// ───────────── شناسهٔ سند ─────────────
+
+export const MAX_DOCUMENT_ID_LENGTH = 64;
+const DOC_ID_RE = /^[a-z0-9]+(?:-[a-z0-9]+)*$/;
+
+export function isValidDocumentId(id: unknown): id is string {
+  return typeof id === "string" && id.length <= MAX_DOCUMENT_ID_LENGTH && DOC_ID_RE.test(id);
+}
+
+/** شناسهٔ رکوردهای دیگر (رأی) با همان قاعدهٔ شناسهٔ سند. */
+export const isValidRecordId = isValidDocumentId;
+
+// ───────────── کلید ارجاع ─────────────
+
+/**
+ * کلید ارجاع (پایدار، ASCII به‌جز برچسب حروفی بند):
+ *   `sample-law/10-bis` یا `sample-law/10/note/2` یا `sample-law/10/clause/الف`.
+ */
+export function formatCitationKey(ref: CitationRef): Result<string> {
+  if (!isValidDocumentId(ref.documentId)) return err("INVALID_INPUT", "شناسهٔ سند نامعتبر است.");
+  const label = parseArticleLabel(ref.article);
+  if (!label.ok) return label;
+  const base = `${ref.documentId}/${articleKey(label.value)}`;
+  if (ref.subpart === null) return ok(base);
+  if (!SUBPART_KINDS.includes(ref.subpart.kind)) return err("INVALID_INPUT", "نوع تبصره/بند نامعتبر است.");
+  const sub = canonicalSubpartLabel(ref.subpart.label);
+  if (!sub.ok) return sub;
+  return ok(`${base}/${ref.subpart.kind}/${sub.value}`);
+}
+
+export function parseCitationKey(key: string): Result<CitationRef> {
+  if (typeof key !== "string") return err("PARSE_ERROR", "کلید ارجاع باید متن باشد.");
+  const parts = key.split("/");
+  if (parts.length !== 2 && parts.length !== 4) return err("PARSE_ERROR", "کلید ارجاع باید «سند/ماده» یا «سند/ماده/نوع/برچسب» باشد.");
+  const [documentId, articlePart, kindPart, labelPart] = parts as [string, string, string | undefined, string | undefined];
+  if (!isValidDocumentId(documentId)) return err("PARSE_ERROR", "شناسهٔ سند در کلید نامعتبر است.");
+  const label = parseArticleKey(articlePart);
+  if (!label.ok) return err("PARSE_ERROR", label.error.message);
+  const article = formatArticleLabel(label.value);
+  if (kindPart === undefined || labelPart === undefined) return ok({ documentId, article, subpart: null });
+  if (kindPart !== "note" && kindPart !== "clause") return err("PARSE_ERROR", "نوع بخش در کلید باید note یا clause باشد.");
+  const sub = canonicalSubpartLabel(labelPart);
+  // برچسب باید همان شکل متعارف باشد (کلید یکتا)
+  if (!sub.ok || sub.value !== labelPart) return err("PARSE_ERROR", "برچسب بخش در کلید متعارف نیست.");
+  return ok({ documentId, article, subpart: { kind: kindPart as SubpartKind, label: sub.value } });
+}
diff --git a/src/modules/legal-kb-schema/load.test.ts b/src/modules/legal-kb-schema/load.test.ts
