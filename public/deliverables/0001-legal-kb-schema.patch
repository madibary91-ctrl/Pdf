+  it("نحو نامعتبر، ورودی غیرمتن و حجم بیش از سقف", () => {
+    for (const bad of ["{", "", "undefined", "{'a':1}", '{"documents":[],}']) {
+      const r = loadCorpusFromJson(bad);
+      expect(!r.ok && r.error[0]?.code).toBe("INVALID_FIELD");
+    }
+    const r2 = loadCorpusFromJson(5 as unknown as string);
+    expect(!r2.ok && r2.error[0]?.code).toBe("INVALID_FIELD");
+    const r3 = loadCorpusFromJson("x".repeat(KB_LIMITS.maxJsonChars + 1));
+    expect(!r3.ok && r3.error[0]?.code).toBe("LIMIT_EXCEEDED");
+  });
+  it("JSON معتبر ولی با شکل نادرست", () => {
+    const r = loadCorpusFromJson("[]");
+    expect(!r.ok && r.error[0]?.code).toBe("INVALID_FIELD");
+  });
+});
+
+describe("فاز: ورودی تصادفی هرگز پرتاب نمی‌کند و خروجی موفق همیشه خودتوان است", () => {
+  function lcg(seed: number) {
+    let s = seed >>> 0;
+    return (n: number) => {
+      s = (Math.imul(s, 1664525) + 1013904223) >>> 0;
+      return s % n;
+    };
+  }
+  const junk: unknown[] = [null, undefined, 0, -1, 1.5, NaN, "", " ", "x", "2024-01-01", "1403-01-01", true, false, [], {}, [1, 2], { a: 1 }, "\u202E", "a\u0000", "ماده ۱۰", Infinity];
+
+  function allPaths(node: unknown, path: (string | number)[], out: (string | number)[][]) {
+    out.push(path);
+    if (Array.isArray(node)) node.forEach((x, i) => allPaths(x, [...path, i], out));
+    else if (node && typeof node === "object") for (const k of Object.keys(node)) allPaths((node as J)[k], [...path, k], out);
+  }
+
+  it("۳۰۰۰ جهش تصادفی روی نمونه", () => {
+    const rnd = lcg(2025);
+    let okCount = 0;
+    let failCount = 0;
+    for (let i = 0; i < 3000; i++) {
+      const c = fresh();
+      const paths: (string | number)[][] = [];
+      allPaths(c, [], paths);
+      const target = paths[1 + rnd(paths.length - 1)] as (string | number)[];
+      const parent = target.slice(0, -1).reduce<J>((n, k) => n[k as string], c);
+      const key = target[target.length - 1] as string | number;
+      const mode = rnd(3);
+      if (mode === 0) parent[key as string] = junk[rnd(junk.length)];
+      else if (mode === 1) delete parent[key as string];
+      else if (Array.isArray(parent)) parent.splice(key as number, 0, junk[rnd(junk.length)]);
+      else parent["zz" + rnd(3)] = junk[rnd(junk.length)];
+      let r: ReturnType<typeof loadCorpus> | undefined;
+      expect(() => (r = loadCorpus(c))).not.toThrow();
+      if (r?.ok) {
+        okCount++;
+        expect(loadCorpus(JSON.parse(JSON.stringify(r.value)))).toEqual(r);
+      } else {
+        failCount++;
+        expect(r && !r.ok && r.error.length > 0).toBe(true);
+      }
+    }
+    // هر دو شاخه واقعاً دیده شده‌اند (تست پوچ نباشد)
+    expect(okCount).toBeGreaterThan(50);
+    expect(failCount).toBeGreaterThan(500);
+  });
+});
diff --git a/src/modules/legal-kb-schema/load.ts b/src/modules/legal-kb-schema/load.ts
new file mode 100644
index 0000000..9ec67e9
--- /dev/null
+++ b/src/modules/legal-kb-schema/load.ts
@@ -0,0 +1,59 @@
+/** `loadCorpus`: تنها دروازهٔ ورود داده به پایگاه دانش. ورودی `unknown` ← `Corpus` معتبر و متعارف، یا فهرست کامل مسائل. */
+import { ok, type Result } from "@/modules/shared-types";
+import { compareIsoDates } from "./dates";
+import { checkIntegrity } from "./integrity";
+import { addIssue, finishIssues, KB_LIMITS, newCtx } from "./issues";
+import { compareArticleLabels, parseArticleLabel } from "./label";
+import { readCorpus } from "./parse";
+import type { Article, Corpus, CorpusIssue } from "./types";
+
+/** ترتیب متعارف: مواد به ترتیب طبیعی برچسب، نسخه‌ها به ترتیب شروع. (ترتیب سندها و رابطه‌ها حفظ می‌شود.) */
+function canonicalize(corpus: Corpus): Corpus {
+  const rank = (a: Article) => {
+    const r = parseArticleLabel(a.label);
+    return r.ok ? r.value : { kind: "single" as const };
+  };
+  return {
+    documents: corpus.documents.map((d) => ({
+      ...d,
+      articles: [...d.articles]
+        .sort((a, b) => compareArticleLabels(rank(a), rank(b)))
+        .map((a) => ({ ...a, versions: [...a.versions].sort((x, y) => compareIsoDates(x.validFrom, y.validFrom)) })),
+    })),
+    relations: corpus.relations,
+    rulings: corpus.rulings,
+  };
+}
+
+export function loadCorpus(input: unknown): Result<Corpus, readonly CorpusIssue[]> {
+  const ctx = newCtx();
+  const corpus = readCorpus(ctx, input);
+  if (corpus && ctx.issues.length === 0) checkIntegrity(corpus, ctx);
+  if (ctx.issues.length > 0 || !corpus) return failure(finishIssues(ctx));
+  return ok(canonicalize(corpus));
+}
+
+export function loadCorpusFromJson(text: string): Result<Corpus, readonly CorpusIssue[]> {
+  const ctx = newCtx();
+  if (typeof text !== "string") {
+    addIssue(ctx, "INVALID_FIELD", "$", "ورودی باید متن JSON باشد.");
+    return failure(finishIssues(ctx));
+  }
+  if (text.length > KB_LIMITS.maxJsonChars) {
+    addIssue(ctx, "LIMIT_EXCEEDED", "$", `حجم JSON بیش از ${KB_LIMITS.maxJsonChars} نویسه است.`);
+    return failure(finishIssues(ctx));
+  }
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(text);
+  } catch {
+    addIssue(ctx, "INVALID_FIELD", "$", "JSON نامعتبر است (خطای نحوی).");
+    return failure(finishIssues(ctx));
+  }
+  return loadCorpus(parsed);
+}
+
+/** `err` مشترک فقط کد دامنه می‌گیرد؛ اینجا خطا فهرست مسائل است. */
+function failure(issues: readonly CorpusIssue[]): Result<never, readonly CorpusIssue[]> {
+  return { ok: false, error: issues };
+}
