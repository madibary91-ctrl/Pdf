+import { describe, expect, it } from "vitest";
+import { loadCorpus } from "./load";
+import { buildCorpusIndex, findArticle, findDocument, relationsFor, resolveCitation, rulingsCiting, versionsInForceAt, type CorpusIndex } from "./lookup";
+import { FICTIONAL_SAMPLE_CORPUS } from "./sample-corpus";
+import type { CitationRef, VersionLookup } from "./types";
+
+type J = Record<string, any>;
+
+function indexOf(input: unknown): CorpusIndex {
+  const r = loadCorpus(input);
+  if (!r.ok) throw new Error(JSON.stringify(r.error));
+  return buildCorpusIndex(r.value);
+}
+const sample = () => indexOf(JSON.parse(JSON.stringify(FICTIONAL_SAMPLE_CORPUS)));
+
+const cite = (documentId: string, article: string, subpart: CitationRef["subpart"] = null): CitationRef => ({ documentId, article, subpart });
+function lookup(index: CorpusIndex, ref: CitationRef, date: string): VersionLookup {
+  const r = resolveCitation(index, ref, date);
+  if (!r.ok) throw new Error(`${r.error.code}: ${r.error.message}`);
+  return r.value;
+}
+/** خلاصهٔ خوانا: found ← متن نسخه */
+function brief(l: VersionLookup): string {
+  switch (l.status) {
+    case "found":
+      return `found:${l.version.validFrom}`;
+    case "gap":
+      return `gap:${l.previousValidTo}..${l.nextValidFrom}`;
+    case "not-yet-in-force":
+      return `not-yet:${l.firstValidFrom}`;
+    case "no-longer-in-force":
+      return `no-longer:${l.lastValidTo}`;
+    default:
+      return l.status;
+  }
+}
+
+describe("نسخه‌بندی زمانی: مرزهای بازهٔ نیم‌باز [validFrom, validTo)", () => {
+  const index = sample();
+  // ماده ۱: [2001-01-01,2010-06-01) [2010-06-01,2015-01-01) شکاف [2018-01-01,∞)
+  const at = (d: string) => brief(lookup(index, cite("sample-law", "1"), d));
+
+  it("پیش از نخستین نسخه", () => {
+    expect(at("2000-12-31")).toBe("not-yet:2001-01-01");
+    expect(at("1800-01-01")).toBe("not-yet:2001-01-01");
+  });
+  it("روز شروع شامل است", () => {
+    expect(at("2001-01-01")).toBe("found:2001-01-01");
+    expect(at("2018-01-01")).toBe("found:2018-01-01");
+  });
+  it("آخرین روز پیش از validTo هنوز معتبر؛ خودِ validTo نسخهٔ بعدی", () => {
+    expect(at("2010-05-31")).toBe("found:2001-01-01");
+    expect(at("2010-06-01")).toBe("found:2010-06-01");
+    expect(at("2014-12-31")).toBe("found:2010-06-01");
+  });
+  it("شکاف: از روز validTo تا یک روز پیش از شروع نسخهٔ بعد", () => {
+    expect(at("2015-01-01")).toBe("gap:2015-01-01..2018-01-01");
+    expect(at("2016-07-15")).toBe("gap:2015-01-01..2018-01-01");
+    expect(at("2017-12-31")).toBe("gap:2015-01-01..2018-01-01");
+  });
+  it("نسخهٔ بی‌پایان تا آخر معتبر است", () => {
+    expect(at("2099-12-31")).toBe("found:2018-01-01");
+    expect(at("2200-12-31")).toBe("found:2018-01-01");
+  });
+  it("مادهٔ نسخ‌شده: پس از validTo آخر «دیگر معتبر نیست»", () => {
+    const at2 = (d: string) => brief(lookup(index, cite("sample-single-act", "واحده"), d));
+    expect(at2("2019-12-31")).toBe("found:2005-01-01");
+    expect(at2("2020-01-01")).toBe("no-longer:2020-01-01");
+    expect(at2("2100-01-01")).toBe("no-longer:2020-01-01");
+    expect(at2("2004-12-31")).toBe("not-yet:2005-01-01");
+  });
+  it("ماده‌ای که در سال‌های بعد افزوده شد", () => {
+    const at3 = (d: string) => brief(lookup(index, cite("sample-law", "2 مکرر"), d));
+    expect(at3("2012-04-30")).toBe("not-yet:2012-05-01");
+    expect(at3("2012-05-01")).toBe("found:2012-05-01");
+  });
+});
+
+describe("resolveCitation: نتیجه‌های صریح", () => {
+  const index = sample();
+  it("سند یا ماده ناموجود", () => {
+    expect(lookup(index, cite("ghost", "1"), "2020-01-01").status).toBe("unknown-document");
+    expect(lookup(index, cite("sample-law", "99"), "2020-01-01").status).toBe("unknown-article");
+    expect(lookup(index, cite("sample-law", "2 مکرر 2"), "2020-01-01").status).toBe("unknown-article");
+    // «۲ مکرر» ≠ «۲»
+    expect(lookup(index, cite("sample-regulation", "2"), "2020-01-01").status).toBe("unknown-article");
+  });
+
+  it("ارقام فارسی/پیشوند «ماده» همان ماده را می‌یابند", () => {
+    const a = lookup(index, cite("sample-law", "۲"), "2020-01-01");
+    const b = lookup(index, cite("sample-law", "ماده 2"), "2020-01-01");
+    expect(a).toEqual(b);
+    expect(lookup(index, cite("sample-law", "ماده ۲ مكرر"), "2020-01-01").status).toBe("found");
+    expect(lookup(index, cite("sample-single-act", "ماده واحده"), "2010-01-01").status).toBe("found");
+  });
+
+  it("تبصره/بند: یافتن، نیافتن و وابستگی به نسخه (تاریخ)", () => {
+    const n = lookup(index, cite("sample-law", "2", { kind: "note", label: "۱" }), "2020-01-01");
+    expect(n.status === "found" && n.subpart?.text).toBe("تبصرهٔ ۱ ساختگی.");
+    const c = lookup(index, cite("sample-law", "2", { kind: "clause", label: "الف" }), "2020-01-01");
+    expect(c.status === "found" && c.subpart?.label).toBe("الف");
+    expect(lookup(index, cite("sample-law", "2", { kind: "clause", label: "پ" }), "2020-01-01").status).toBe("unknown-subpart");
+    expect(lookup(index, cite("sample-law", "2", { kind: "note", label: "الف" }), "2020-01-01").status).toBe("unknown-subpart"); // نوع متفاوت
+    // ماده ۱: تبصرهٔ ۱ فقط در نسخهٔ دوم هست
+    expect(lookup(index, cite("sample-law", "1", { kind: "note", label: "1" }), "2005-01-01").status).toBe("unknown-subpart");
+    expect(lookup(index, cite("sample-law", "1", { kind: "note", label: "1" }), "2012-01-01").status).toBe("found");
+    expect(lookup(index, cite("sample-law", "1", { kind: "note", label: "1" }), "2020-01-01").status).toBe("unknown-subpart");
+    // وقتی ماده در آن تاریخ معتبر نیست، وضعیت زمانی گزارش می‌شود نه subpart
+    expect(lookup(index, cite("sample-law", "1", { kind: "note", label: "1" }), "2016-01-01").status).toBe("gap");
+  });
+
+  it("verified: فقط وقتی نسخه (نه سند) «legally-verified» است", () => {
+    const f = (ref: CitationRef, d: string) => {
+      const l = lookup(index, ref, d);
+      return l.status === "found" ? l.verified : null;
+    };
+    expect(f(cite("sample-law", "1"), "2005-01-01")).toBe(true); // نسخهٔ نخست تأییدشده
+    expect(f(cite("sample-law", "1"), "2012-01-01")).toBe(false); // نسخهٔ دوم نه
+    expect(f(cite("sample-law", "2"), "2020-01-01")).toBe(true);
+    expect(f(cite("sample-regulation", "1"), "2020-01-01")).toBe(false);
+  });
+
+  it("found شامل کل نسخه و برچسب متعارف است", () => {
+    const l = lookup(index, cite("sample-law", "ماده ۲ مكرر"), "2020-01-01");
+    expect(l.status === "found" && l.article).toBe("2 مکرر");
+    expect(l.status === "found" && l.documentId).toBe("sample-law");
+    expect(l.status === "found" && l.version.text).toBe("متن ساختگی ماده ۲ مکرر.");
+    expect(l.status === "found" && l.subpart).toBeNull();
+  });
+
+  it("ورودی بد = خطای Result، نه نتیجهٔ جعلی", () => {
+    const err = (ref: CitationRef, d: string) => {
+      const r = resolveCitation(index, ref, d);
+      return r.ok ? "OK" : r.error.code;
+    };
+    expect(err(cite("sample-law", "1"), "2020-13-01")).toBe("INVALID_DATE");
+    expect(err(cite("sample-law", "1"), "1403-01-01")).toBe("INVALID_DATE");
+    expect(err(cite("sample-law", "1"), "")).toBe("INVALID_DATE");
+    expect(err(cite("sample-law", "1"), 5 as unknown as string)).toBe("INVALID_DATE");
+    expect(err(cite("sample-law", "abc"), "2020-01-01")).toBe("INVALID_INPUT");
+    expect(err(cite("sample-law", "0"), "2020-01-01")).toBe("OUT_OF_RANGE");
+    expect(err(cite("sample-law", "1", { kind: "note", label: "zz" }), "2020-01-01")).toBe("INVALID_INPUT");
+    expect(err(cite("sample-law", "1", { kind: "para" as "note", label: "1" }), "2020-01-01")).toBe("INVALID_INPUT");
+    // شناسهٔ سند نامعتبر خطا نیست؛ «سند ناموجود» است
+    expect(lookup(index, cite("BAD ID", "1"), "2020-01-01").status).toBe("unknown-document");
+  });
+
+  it("«hasOwnProperty»/«__proto__» به‌عنوان شناسهٔ سند چیزی نمی‌یابد", () => {
+    for (const id of ["__proto__", "constructor", "toString", "hasOwnProperty"]) {
+      expect(lookup(index, cite(id, "1"), "2020-01-01").status).toBe("unknown-document");
+    }
+  });
+});
+
+describe("جست‌وجوهای کمکی", () => {
+  const index = sample();
+
+  it("findDocument / findArticle", () => {
+    expect(findDocument(index, "sample-law")?.title).toContain("نمونه");
+    expect(findDocument(index, "ghost")).toBeUndefined();
+    expect(findArticle(index, "sample-law", "۲ مکرر")?.label).toBe("2 مکرر");
+    expect(findArticle(index, "sample-law", "99")).toBeUndefined();
+    expect(findArticle(index, "sample-law", "نامعتبر!")).toBeUndefined();
+  });
+
+  it("versionsInForceAt: فیلتر تاریخ اعتبار", () => {
+    const list = (d: string) => {
+      const r = versionsInForceAt(index, d);
+      if (!r.ok) throw new Error("x");
+      return r.value.map((e) => `${e.documentId}/${e.article}@${e.version.validFrom}`);
+    };
+    expect(list("2000-01-01")).toEqual([]);
+    expect(list("2002-01-01")).toEqual(["sample-law/1@2001-01-01", "sample-law/2@2001-01-01"]);
+    expect(list("2011-01-01")).toEqual(["sample-law/1@2010-06-01", "sample-law/2@2001-01-01", "sample-single-act/واحده@2005-01-01", "sample-regulation/1@2003-01-01"]);
+    // ماده ۱ در شکاف است و نیست؛ «واحده» هنوز تا ۲۰۲۰ معتبر است
+    expect(list("2016-01-01")).toEqual(["sample-law/2@2001-01-01", "sample-law/2 مکرر@2012-05-01", "sample-single-act/واحده@2005-01-01", "sample-regulation/1@2003-01-01"]);
+    // از ۲۰۲۰-۰۱-۰۱ «واحده» (validTo) دیگر معتبر نیست
+    expect(list("2020-01-01")).toEqual(["sample-law/1@2018-01-01", "sample-law/2@2001-01-01", "sample-law/2 مکرر@2012-05-01", "sample-regulation/1@2003-01-01"]);
+    const bad = versionsInForceAt(index, "2020-02-30");
+    expect(!bad.ok && bad.error.code).toBe("INVALID_DATE");
+  });
+
+  it("relationsFor: ماده شامل رابطه‌های سطح سند هم می‌شود (قابل خاموش‌کردن)", () => {
+    const types = (rs: readonly { type: string }[]) => rs.map((r) => r.type);
+    // ماده ۲ قانون نمونه: اصلاحیه (مبدأ) + رابطه‌های سطح سند (اجرا: مقصد، نسخ: مبدأ)
+    expect(types(relationsFor(index, { documentId: "sample-law", article: "2" }))).toEqual(["implements", "repeals", "amends"]);
+    expect(types(relationsFor(index, { documentId: "sample-law", article: "2" }, { includeDocumentLevel: false }))).toEqual(["amends"]);
+    // ماده ۱ (مقصد اصلاح)
+    expect(types(relationsFor(index, { documentId: "sample-law", article: "1" }, { includeDocumentLevel: false }))).toEqual(["amends"]);
+    // خود سند: دقیقاً رابطه‌های سطح سند
+    expect(types(relationsFor(index, { documentId: "sample-law", article: null }))).toEqual(["implements", "repeals"]);
+    expect(types(relationsFor(index, { documentId: "sample-single-act", article: null }))).toEqual(["repeals"]);
+    expect(relationsFor(index, { documentId: "ghost", article: null })).toEqual([]);
+  });
+
+  it("rulingsCiting فقط همان گره را می‌دهد", () => {
+    expect(rulingsCiting(index, { documentId: "sample-law", article: "2" }).map((g) => g.id)).toEqual(["sample-unity-ruling-1"]);
+    expect(rulingsCiting(index, { documentId: "sample-law", article: "۲" }).length).toBe(1);
+    expect(rulingsCiting(index, { documentId: "sample-law", article: "1" })).toEqual([]);
+    expect(rulingsCiting(index, { documentId: "sample-law", article: null })).toEqual([]);
+  });
+
+  it("رابطه‌ای که هم سطح سند و هم سطح ماده را لمس می‌کند، یک بار می‌آید", () => {
+    const c = JSON.parse(JSON.stringify(FICTIONAL_SAMPLE_CORPUS)) as J;
+    c.relations = [{ ...c.relations[0], type: "refers-to", from: { documentId: "sample-law", article: null }, to: { documentId: "sample-law", article: "1" } }];
+    const idx = indexOf(c);
+    expect(relationsFor(idx, { documentId: "sample-law", article: "1" }).length).toBe(1);
+  });
+});
+
+// ───────────── oracle مستقل: حساب روی «شمارهٔ روز» صحیح، نه رشته ─────────────
+
+describe("مقایسهٔ انبوه با oracle (نمایش عددی روز؛ منطق جدا از موتور)", () => {
+  function lcg(seed: number) {
+    let s = seed >>> 0;
+    return (n: number) => {
+      s = (Math.imul(s, 1664525) + 1013904223) >>> 0;
+      return s % n;
+    };
+  }
+  const DAY = 86_400_000;
+  const BASE = Date.UTC(2000, 0, 1) / DAY;
+  const iso = (day: number) => new Date((BASE + day) * DAY).toISOString().slice(0, 10);
+
+  type Seg = { s: number; e: number | null };
+  /** oracle: فقط مقایسهٔ عددی */
+  function oracle(segs: Seg[], t: number): string {
+    for (const g of segs) if (t >= g.s && (g.e === null || t < g.e)) return `found:${iso(g.s)}`;
+    if (t < segs[0]!.s) return `not-yet:${iso(segs[0]!.s)}`;
+    const last = segs[segs.length - 1]!;
+    if (last.e !== null && t >= last.e) return `no-longer:${iso(last.e)}`;
+    const prev = [...segs].reverse().find((g) => g.e !== null && g.e <= t)!;
+    const next = segs.find((g) => g.s > t)!;
+    return `gap:${iso(prev.e as number)}..${iso(next.s)}`;
+  }
+
+  it("۳۰۰ زنجیرهٔ تصادفی × همهٔ روزهای مرزی و تصادفی", () => {
+    const rnd = lcg(99);
+    let checks = 0;
+    let kinds = new Set<string>();
+    for (let n = 0; n < 300; n++) {
+      const count = 1 + rnd(5);
+      const segs: Seg[] = [];
+      let cursor = rnd(300);
+      for (let i = 0; i < count; i++) {
+        const s = cursor;
+        const last = i === count - 1;
+        const open = last && rnd(2) === 0;
+        const e = open ? null : s + 1 + rnd(400);
+        segs.push({ s, e });
+        cursor = (e ?? s) + (rnd(3) === 0 ? 1 + rnd(200) : 0); // گاهی شکاف، گاهی چسبیده
+      }
+      const sampleJson = JSON.parse(JSON.stringify(FICTIONAL_SAMPLE_CORPUS)) as J;
+      const prov = sampleJson.documents[0].articles[0].versions[0].provenance;
+      sampleJson.documents = [
+        {
+          ...sampleJson.documents[0],
+          articles: [{ label: "7", versions: segs.map((g, i) => ({ validFrom: iso(g.s), validTo: g.e === null ? null : iso(g.e), text: `نسخه ${i}`, subparts: [], provenance: prov })) }],
+        },
+      ];
+      sampleJson.relations = [];
+      sampleJson.rulings = [];
+      const index = indexOf(sampleJson);
+      const days = new Set<number>();
+      for (const g of segs) for (const d of [g.s - 1, g.s, g.s + 1, (g.e ?? g.s) - 1, g.e ?? g.s, (g.e ?? g.s) + 1]) days.add(d);
+      for (let k = 0; k < 10; k++) days.add(rnd(1400) - 50);
+      const maxEnd = Math.max(...segs.map((g) => g.e ?? g.s));
+      days.add(maxEnd + 5000);
+      for (const t of days) {
+        const got = brief(lookup(index, cite("sample-law", "7"), iso(t)));
+        const want = oracle(segs, t);
+        expect(got, `زنجیره ${n} روز ${iso(t)} ${JSON.stringify(segs)}`).toBe(want);
+        kinds.add(want.split(":")[0]!);
+        checks++;
+      }
+    }
+    expect(checks).toBeGreaterThan(5000);
+    // همهٔ چهار وضعیت زمانی واقعاً دیده شده‌اند
+    expect([...kinds].sort()).toEqual(["found", "gap", "no-longer", "not-yet"]);
+  });
+});
diff --git a/src/modules/legal-kb-schema/lookup.ts b/src/modules/legal-kb-schema/lookup.ts
new file mode 100644
index 0000000..c832fbf
--- /dev/null
+++ b/src/modules/legal-kb-schema/lookup.ts
@@ -0,0 +1,148 @@
+/**
+ * شاخص خواندنی روی Corpus معتبر + جست‌وجوی نسخهٔ معتبر در یک تاریخ (نسخه‌بندی زمانی).
+ * همه‌چیز خالص و قطعی است؛ «امروز» از بیرون می‌آید.
+ */
+import { err, ok, type Result } from "@/modules/shared-types";
+import { compareIsoDates, parseIsoDate } from "./dates";
+import { canonicalArticleLabel, articleKey, canonicalSubpartLabel, parseArticleLabel } from "./label";
+import type { Article, ArticleVersion, CitationRef, Corpus, IsoDate, LawDocument, NodeRef, Relation, Ruling, VersionLookup } from "./types";
+
+type ArticleEntry = Readonly<{ document: LawDocument; article: Article }>;
+
+export type CorpusIndex = Readonly<{
+  corpus: Corpus;
+  documents: ReadonlyMap<string, LawDocument>;
+  articles: ReadonlyMap<string, ArticleEntry>;
+  relationsByNode: ReadonlyMap<string, readonly Relation[]>;
+  rulingsByNode: ReadonlyMap<string, readonly Ruling[]>;
+}>;
+
+const nodeKey = (documentId: string, article: string | null): string => {
+  if (article === null) return documentId;
+  const l = parseArticleLabel(article);
+  return `${documentId}/${l.ok ? articleKey(l.value) : article}`;
+};
+
+function push<V>(map: Map<string, V[]>, key: string, value: V): void {
+  const list = map.get(key);
+  if (list) list.push(value);
+  else map.set(key, [value]);
+}
+
+/** فقط روی خروجی `loadCorpus` تضمین درستی دارد. */
+export function buildCorpusIndex(corpus: Corpus): CorpusIndex {
+  const documents = new Map<string, LawDocument>();
+  const articles = new Map<string, ArticleEntry>();
+  const relationsByNode = new Map<string, Relation[]>();
+  const rulingsByNode = new Map<string, Ruling[]>();
+  for (const document of corpus.documents) {
+    documents.set(document.id, document);
+    for (const article of document.articles) articles.set(nodeKey(document.id, article.label), { document, article });
+  }
+  for (const r of corpus.relations) {
+    const a = nodeKey(r.from.documentId, r.from.article);
+    const b = nodeKey(r.to.documentId, r.to.article);
+    push(relationsByNode, a, r);
+    push(relationsByNode, b, r); // a≠b همیشه (رابطه با خودش در loadCorpus رد می‌شود)
+  }
+  for (const g of corpus.rulings) for (const c of g.cites) push(rulingsByNode, nodeKey(c.documentId, c.article), g);
+  return { corpus, documents, articles, relationsByNode, rulingsByNode };
+}
+
+export function findDocument(index: CorpusIndex, documentId: string): LawDocument | undefined {
+  return index.documents.get(documentId);
+}
+
+export function findArticle(index: CorpusIndex, documentId: string, articleLabel: string): Article | undefined {
+  const c = canonicalArticleLabel(articleLabel);
+  return c.ok ? index.articles.get(nodeKey(documentId, c.value))?.article : undefined;
+}
+
+/** نسخهٔ معتبر در تاریخ (بازهٔ نیم‌باز)؛ آرایهٔ نسخه‌ها مرتب است (خروجی loadCorpus). */
+function versionAt(versions: readonly ArticleVersion[], date: IsoDate): VersionLookup | ArticleVersion {
+  let previous: ArticleVersion | null = null;
+  for (const v of versions) {
+    if (compareIsoDates(date, v.validFrom) < 0) {
+      if (previous === null) return { status: "not-yet-in-force", firstValidFrom: v.validFrom };
+      // previous.validTo ≤ date < v.validFrom ⇒ شکاف (اگر previous بی‌پایان بود، درونش می‌افتاد)
+      return { status: "gap", previousValidTo: previous.validTo as IsoDate, nextValidFrom: v.validFrom };
+    }
+    if (v.validTo === null || compareIsoDates(date, v.validTo) < 0) return v;
+    previous = v;
+  }
+  return { status: "no-longer-in-force", lastValidTo: (previous as ArticleVersion).validTo as IsoDate };
+}
+
+function isVersion(x: VersionLookup | ArticleVersion): x is ArticleVersion {
+  return "validFrom" in x;
+}
+
+/**
+ * ارجاع را در تاریخ مشخص حل می‌کند. خطای `Result` فقط برای ورودی بد (تاریخ، ارجاع)؛
+ * «سند/ماده/بخش نیست» و «در آن تاریخ معتبر نیست» نتیجهٔ عادی (`status`) هستند تا راستی‌آزمایی روی همه switch کند.
+ * ⚠️ `found.verified=false` یعنی نسخه هنوز توسط حقوقدان تأیید نشده و نباید به‌عنوان استنادِ قطعی به کاربر برسد.
+ */
+export function resolveCitation(index: CorpusIndex, ref: CitationRef, onDate: IsoDate): Result<VersionLookup> {
+  const d = parseIsoDate(onDate);
+  if (!d.ok) return d;
+  const label = canonicalArticleLabel(ref.article);
+  if (!label.ok) return label;
+  if (ref.subpart !== null && ref.subpart.kind !== "note" && ref.subpart.kind !== "clause") return err("INVALID_INPUT", "نوع تبصره/بند نامعتبر است.");
+  const sub = ref.subpart === null ? null : canonicalSubpartLabel(ref.subpart.label);
+  if (sub && !sub.ok) return sub;
+
+  const document = index.documents.get(ref.documentId);
+  if (!document) return ok({ status: "unknown-document" });
+  const entry = index.articles.get(nodeKey(ref.documentId, label.value));
+  if (!entry) return ok({ status: "unknown-article" });
+
+  const found = versionAt(entry.article.versions, d.value);
+  if (!isVersion(found)) return ok(found);
+
+  let subpart = null;
+  if (ref.subpart !== null && sub && sub.ok) {
+    subpart = found.subparts.find((s) => s.kind === ref.subpart?.kind && s.label === sub.value) ?? null;
+    if (!subpart) return ok({ status: "unknown-subpart", version: found });
+  }
+  return ok({
+    status: "found",
+    documentId: ref.documentId,
+    article: label.value,
+    version: found,
+    subpart,
+    verified: found.provenance.review.status === "legally-verified",
+  });
+}
+
+export type InForceEntry = Readonly<{ documentId: string; article: string; version: ArticleVersion; verified: boolean }>;
+
+/** همهٔ مواد معتبر در یک تاریخ (برای فیلتر تاریخ در بازیابی). ترتیب: ترتیب سندها و مواد. */
+export function versionsInForceAt(index: CorpusIndex, onDate: IsoDate): Result<readonly InForceEntry[]> {
+  const d = parseIsoDate(onDate);
+  if (!d.ok) return d;
+  const out: InForceEntry[] = [];
+  for (const doc of index.corpus.documents) {
+    for (const article of doc.articles) {
+      const v = versionAt(article.versions, d.value);
+      if (isVersion(v)) out.push({ documentId: doc.id, article: article.label, version: v, verified: v.provenance.review.status === "legally-verified" });
+    }
+  }
+  return ok(out);
+}
+
+/**
+ * رابطه‌های یک گره. برای گرهٔ «ماده»، رابطه‌های سطح کل سند هم به‌طور پیش‌فرض می‌آیند
+ * (مثلاً «قانون الف، قانون ب را نسخ کرد» همهٔ مواد ب را درگیر می‌کند).
+ */
+export function relationsFor(index: CorpusIndex, ref: NodeRef, options: Readonly<{ includeDocumentLevel?: boolean }> = {}): readonly Relation[] {
+  const exact = index.relationsByNode.get(nodeKey(ref.documentId, ref.article)) ?? [];
+  if (ref.article === null || options.includeDocumentLevel === false) return exact;
+  const docLevel = index.relationsByNode.get(ref.documentId) ?? [];
+  // یک رابطه ممکن است هم در سطح سند و هم در سطح ماده بنشیند (مثلاً مبدأ سند، مقصد ماده)؛ فقط یک بار برگردد.
+  return Array.from(new Set([...docLevel, ...exact]));
+}
+
+/** رأی‌هایی که به این گره ارجاع دارند (دقیقاً همین گره؛ ارجاع به کل سند جدا شمرده می‌شود). */
+export function rulingsCiting(index: CorpusIndex, ref: NodeRef): readonly Ruling[] {
+  return index.rulingsByNode.get(nodeKey(ref.documentId, ref.article)) ?? [];
+}
diff --git a/src/modules/legal-kb-schema/parse.ts b/src/modules/legal-kb-schema/parse.ts
new file mode 100644
index 0000000..6431baf
--- /dev/null
+++ b/src/modules/legal-kb-schema/parse.ts
@@ -0,0 +1,192 @@
+/**
+ * ورودی `unknown` (JSON) → `Corpus` تایپ‌دار و متعارف (داخلی؛ رابط عمومی: `loadCorpus` در load.ts).
+ * سخت‌گیرانه: کلید ناشناخته، نوع نادرست، تاریخ ناممکن، متن خالی و نویسهٔ خطرناک همه مسئله‌اند.
+ */
+import { canonicalSubpartLabel, isValidRecordId } from "./label";
+import { addIssue, KB_LIMITS, type Ctx } from "./issues";
+import {
+  articleLabelValue,
+  explicitNullableDate,
+  optDate,
+  optText,
+  optUrl,
+  readArray,
+  record,
+  reqDate,
+  reqEnum,
+  reqText,
+  type Rec,
+} from "./reader";
+import {
+  DOCUMENT_KINDS,
+  RELATION_TYPES,
+  RULING_KINDS,
+  SUBPART_KINDS,
+  type Article,
+  type ArticleVersion,
+  type Corpus,
+  type LawDocument,
+  type NodeRef,
+  type Provenance,
+  type Relation,
+  type Review,
+  type Ruling,
+  type Subpart,
+} from "./types";
+
+const PENDING: Review = { status: "pending-legal-review", reviewedBy: null, reviewedOn: null };
+
+/** مقدار جایگزین فقط برای ادامهٔ بررسی پس از خطا؛ هرگز به خروجی نمی‌رسد. */
+const NO_PROVENANCE: Provenance = { sourceName: "", sourceUrl: null, sourceKind: "secondary", retrievedOn: null, review: PENDING };
+
+function readReview(ctx: Ctx, v: unknown, path: string): Review {
+  if (v === undefined) return PENDING; // پیش‌فرض امن: تأییدنشده
+  const rec = record(ctx, v, path, ["status", "reviewedBy", "reviewedOn"]);
+  if (!rec) return PENDING;
+  const status = reqEnum(ctx, rec, "status", path, ["pending-legal-review", "legally-verified"] as const, "pending-legal-review");
+  const reviewedBy = optText(ctx, rec, "reviewedBy", path, { max: 200 });
+  const reviewedOn = optDate(ctx, rec, "reviewedOn", path);
+  if (status === "legally-verified" && (reviewedBy === null || reviewedOn === null)) {
+    addIssue(ctx, "REVIEW_INCONSISTENT", path, "وضعیت «legally-verified» نام بازبین (reviewedBy) و تاریخ بازبینی (reviewedOn) را لازم دارد.");
+  }
+  if (status === "pending-legal-review" && (reviewedBy !== null || reviewedOn !== null)) {
+    addIssue(ctx, "REVIEW_INCONSISTENT", path, "وضعیت «pending-legal-review» نباید نام یا تاریخ بازبین داشته باشد.");
+  }
+  return { status, reviewedBy, reviewedOn };
+}
+
+function readProvenance(ctx: Ctx, v: unknown, path: string): Provenance {
+  if (v === undefined) {
+    addIssue(ctx, "MISSING_FIELD", path, "منبع (provenance) الزامی است.");
+    return NO_PROVENANCE;
+  }
+  const rec = record(ctx, v, path, ["sourceName", "sourceUrl", "sourceKind", "retrievedOn", "review"]);
+  if (!rec) return NO_PROVENANCE;
+  return {
+    sourceName: reqText(ctx, rec, "sourceName", path, { max: 300 }),
+    sourceUrl: optUrl(ctx, rec, "sourceUrl", path),
+    sourceKind: reqEnum(ctx, rec, "sourceKind", path, ["official", "secondary"] as const, "secondary"),
+    retrievedOn: optDate(ctx, rec, "retrievedOn", path),
+    review: readReview(ctx, rec["review"], `${path}.review`),
+  };
+}
+
+function readSubpart(ctx: Ctx, v: unknown, path: string): Subpart {
+  const fallback: Subpart = { kind: "note", label: "1", text: "" };
+  const rec = record(ctx, v, path, ["kind", "label", "text"]);
+  if (!rec) return fallback;
+  const kind = reqEnum(ctx, rec, "kind", path, SUBPART_KINDS, "note");
+  let label = "";
+  if (rec["label"] === undefined) addIssue(ctx, "MISSING_FIELD", `${path}.label`, "این کلید الزامی است.");
+  else if (typeof rec["label"] !== "string") addIssue(ctx, "INVALID_FIELD", `${path}.label`, "برچسب باید متن باشد.");
+  else {
+    const r = canonicalSubpartLabel(rec["label"]);
+    if (r.ok) label = r.value;
+    else addIssue(ctx, "INVALID_FIELD", `${path}.label`, r.error.message);
+  }
+  return { kind, label, text: reqText(ctx, rec, "text", path, { multiline: true }) };
+}
+
+function readVersion(ctx: Ctx, v: unknown, path: string): ArticleVersion {
+  const empty: ArticleVersion = { validFrom: "1900-01-01", validTo: null, text: "", subparts: [], provenance: NO_PROVENANCE };
+  const rec = record(ctx, v, path, ["validFrom", "validTo", "text", "subparts", "provenance"]);
+  if (!rec) return empty;
+  const subparts = readArray(ctx, rec, "subparts", path, KB_LIMITS.subpartsPerVersion, false).map((s, i) => readSubpart(ctx, s, `${path}.subparts[${i}]`));
+  return {
+    validFrom: reqDate(ctx, rec, "validFrom", path),
+    validTo: explicitNullableDate(ctx, rec, "validTo", path),
+    text: reqText(ctx, rec, "text", path, { multiline: true }),
+    subparts,
+    provenance: readProvenance(ctx, rec["provenance"], `${path}.provenance`),
+  };
+}
+
+function readArticle(ctx: Ctx, v: unknown, path: string): Article {
+  const rec = record(ctx, v, path, ["label", "versions"]);
+  if (!rec) return { label: "", versions: [] };
+  const label = rec["label"] === undefined ? (addIssue(ctx, "MISSING_FIELD", `${path}.label`, "این کلید الزامی است."), "") : articleLabelValue(ctx, rec["label"], `${path}.label`);
+  const raw = readArray(ctx, rec, "versions", path, KB_LIMITS.versionsPerArticle, true);
+  if (Array.isArray(rec["versions"]) && rec["versions"].length === 0) {
+    addIssue(ctx, "MISSING_FIELD", `${path}.versions`, "هر ماده حداقل یک نسخه لازم دارد.");
+  }
+  return { label, versions: raw.map((x, i) => readVersion(ctx, x, `${path}.versions[${i}]`)) };
+}
+
+function readDocument(ctx: Ctx, v: unknown, path: string): LawDocument {
+  const rec = record(ctx, v, path, ["id", "kind", "title", "shortTitle", "enactedOn", "provenance", "articles"]);
+  const empty = (): LawDocument => ({ id: "", kind: "statute", title: "", shortTitle: null, enactedOn: null, provenance: NO_PROVENANCE, articles: [] });
+  if (!rec) return empty();
+  const id = readRecordId(ctx, rec, "id", path);
+  const articles = readArray(ctx, rec, "articles", path, KB_LIMITS.articlesPerDocument, true).map((a, i) => readArticle(ctx, a, `${path}.articles[${i}]`));
+  return {
+    id,
+    kind: reqEnum(ctx, rec, "kind", path, DOCUMENT_KINDS, "statute"),
+    title: reqText(ctx, rec, "title", path, { max: 300 }),
+    shortTitle: optText(ctx, rec, "shortTitle", path, { max: 100 }),
+    enactedOn: optDate(ctx, rec, "enactedOn", path),
+    provenance: readProvenance(ctx, rec["provenance"], `${path}.provenance`),
+    articles,
+  };
+}
+
+function readRecordId(ctx: Ctx, rec: Rec, key: string, path: string): string {
+  const p = `${path}.${key}`;
+  const v = rec[key];
+  if (v === undefined) {
+    addIssue(ctx, "MISSING_FIELD", p, "این کلید الزامی است.");
+    return "";
+  }
+  if (!isValidRecordId(v)) {
+    addIssue(ctx, "INVALID_FIELD", p, "شناسه باید لاتین کوچک (حرف، عدد و خط تیره، مثل sample-law) و حداکثر ۶۴ نویسه باشد.");
+    return "";
+  }
+  return v;
+}
+
+function readNodeRef(ctx: Ctx, v: unknown, path: string): NodeRef {
+  const rec = record(ctx, v, path, ["documentId", "article"]);
+  if (!rec) return { documentId: "", article: null };
+  const documentId = readRecordId(ctx, rec, "documentId", path);
+  const a = rec["article"];
+  const article = a === undefined || a === null ? null : articleLabelValue(ctx, a, `${path}.article`);
+  return { documentId, article };
+}
+
+function readRelation(ctx: Ctx, v: unknown, path: string): Relation {
+  const rec = record(ctx, v, path, ["type", "from", "to", "effectiveFrom", "note", "provenance"]);
+  if (!rec) return { type: "refers-to", from: { documentId: "", article: null }, to: { documentId: "", article: null }, effectiveFrom: null, note: null, provenance: NO_PROVENANCE };
+  return {
+    type: reqEnum(ctx, rec, "type", path, RELATION_TYPES, "refers-to"),
+    from: rec["from"] === undefined ? (addIssue(ctx, "MISSING_FIELD", `${path}.from`, "این کلید الزامی است."), { documentId: "", article: null }) : readNodeRef(ctx, rec["from"], `${path}.from`),
+    to: rec["to"] === undefined ? (addIssue(ctx, "MISSING_FIELD", `${path}.to`, "این کلید الزامی است."), { documentId: "", article: null }) : readNodeRef(ctx, rec["to"], `${path}.to`),
+    effectiveFrom: explicitNullableDate(ctx, rec, "effectiveFrom", path),
+    note: optText(ctx, rec, "note", path, { multiline: true, max: 2000 }),
+    provenance: readProvenance(ctx, rec["provenance"], `${path}.provenance`),
+  };
+}
+
+function readRuling(ctx: Ctx, v: unknown, path: string): Ruling {
+  const rec = record(ctx, v, path, ["id", "kind", "number", "issuer", "issuedOn", "title", "text", "cites", "provenance"]);
+  if (!rec) return { id: "", kind: "judgment", number: "", issuer: "", issuedOn: "1900-01-01", title: null, text: "", cites: [], provenance: NO_PROVENANCE };
+  return {
+    id: readRecordId(ctx, rec, "id", path),
+    kind: reqEnum(ctx, rec, "kind", path, RULING_KINDS, "judgment"),
+    number: reqText(ctx, rec, "number", path, { max: 100 }),
+    issuer: reqText(ctx, rec, "issuer", path, { max: 300 }),
+    issuedOn: reqDate(ctx, rec, "issuedOn", path),
+    title: optText(ctx, rec, "title", path, { max: 300 }),
+    text: reqText(ctx, rec, "text", path, { multiline: true }),
+    cites: readArray(ctx, rec, "cites", path, KB_LIMITS.citesPerRuling, false).map((c, i) => readNodeRef(ctx, c, `${path}.cites[${i}]`)),
+    provenance: readProvenance(ctx, rec["provenance"], `${path}.provenance`),
+  };
+}
+
+export function readCorpus(ctx: Ctx, input: unknown): Corpus | null {
+  const rec = record(ctx, input, "$", ["documents", "relations", "rulings"]);
+  if (!rec) return null;
+  return {
+    documents: readArray(ctx, rec, "documents", "$", KB_LIMITS.documents, true).map((d, i) => readDocument(ctx, d, `documents[${i}]`)),
+    relations: readArray(ctx, rec, "relations", "$", KB_LIMITS.relations, false).map((r, i) => readRelation(ctx, r, `relations[${i}]`)),
+    rulings: readArray(ctx, rec, "rulings", "$", KB_LIMITS.rulings, false).map((r, i) => readRuling(ctx, r, `rulings[${i}]`)),
+  };
+}
diff --git a/src/modules/legal-kb-schema/reader.ts b/src/modules/legal-kb-schema/reader.ts
new file mode 100644
index 0000000..5507ae9
--- /dev/null
+++ b/src/modules/legal-kb-schema/reader.ts
@@ -0,0 +1,166 @@
+/**
+ * خواننده‌های سخت‌گیرِ مرزی برای ورودی `unknown` (داخلی).
+ * قاعده: هر خطا یک مسئلهٔ دقیق با مسیر؛ مقدار جایگزین فقط برای ادامهٔ بررسی است و هرگز به خروجی نمی‌رسد.
+ */
+import { canonicalArticleLabel } from "./label";
+import { isValidIsoDate } from "./dates";
+import { addIssue, KB_LIMITS, type Ctx } from "./issues";
+import type { IsoDate } from "./types";
+
+export type Rec = Readonly<Record<string, unknown>>;
+
+export function isPlainObject(v: unknown): v is Rec {
+  if (typeof v !== "object" || v === null || Array.isArray(v)) return false;
+  const proto = Object.getPrototypeOf(v);
+  return proto === Object.prototype || proto === null;
+}
+
+/** نویسه‌های کنترلی، علامت‌های جهت‌دهی «Trojan Source» و BOM؛ (تب و خط‌جدید و RLM/LRM مجازند.) */
+const FORBIDDEN_CHARS = /[\u0000-\u0008\u000B\u000C\u000E-\u001F\u007F-\u009F\u202A-\u202E\u2066-\u2069\uFEFF]/;
+
+export function record(ctx: Ctx, v: unknown, path: string, allowed: readonly string[]): Rec | null {
+  if (!isPlainObject(v)) {
+    addIssue(ctx, "INVALID_FIELD", path, "باید یک شیء (object) باشد.");
+    return null;
+  }
+  for (const k of Object.keys(v)) {
+    if (!allowed.includes(k)) addIssue(ctx, "UNKNOWN_FIELD", `${path}.${k}`, `کلید ناشناخته «${k}»؛ کلیدهای مجاز: ${allowed.join("، ")}.`);
+  }
+  return v;
+}
+
+function has(rec: Rec, key: string): boolean {
+  return Object.prototype.hasOwnProperty.call(rec, key) && rec[key] !== undefined;
+}
+
+export function readArray(ctx: Ctx, rec: Rec, key: string, path: string, max: number, required: boolean): readonly unknown[] {
+  const p = `${path}.${key}`;
+  if (!has(rec, key)) {
+    if (required) addIssue(ctx, "MISSING_FIELD", p, "این کلید الزامی است.");
+    return [];
+  }
+  const v = rec[key];
+  if (!Array.isArray(v)) {
+    addIssue(ctx, "INVALID_FIELD", p, "باید آرایه باشد.");
+    return [];
+  }
+  if (v.length > max) {
+    addIssue(ctx, "LIMIT_EXCEEDED", p, `حداکثر ${max} عضو مجاز است.`);
+    return [];
+  }
+  // Array.from خانه‌های خالیِ آرایهٔ تُنُک (sparse) را به undefined تبدیل می‌کند تا خواندنِ عضو آن را مسئله کند؛
+  // `.map` مستقیم روی آرایهٔ تُنُک خانه‌های خالی را بی‌صدا رد می‌کرد (باگی که تست فازی گرفت).
+  return Array.from(v);
+}
+
+type TextOpts = Readonly<{ multiline?: boolean; max?: number }>;
+
+function cleanText(ctx: Ctx, raw: unknown, p: string, opts: TextOpts): string | null {
+  if (typeof raw !== "string") {
+    addIssue(ctx, "INVALID_FIELD", p, "باید متن باشد.");
+    return null;
+  }
+  const multiline = opts.multiline === true;
+  const max = opts.max ?? (multiline ? KB_LIMITS.textChars : KB_LIMITS.lineChars);
+  const s = (multiline ? raw.replace(/\r\n?/g, "\n") : raw).trim();
+  if (s === "") {
+    addIssue(ctx, "INVALID_FIELD", p, "نباید خالی باشد.");
+    return null;
+  }
+  if (s.length > max) {
+    addIssue(ctx, "LIMIT_EXCEEDED", p, `حداکثر ${max} نویسه مجاز است.`);
+    return null;
+  }
+  if (FORBIDDEN_CHARS.test(s)) {
+    addIssue(ctx, "INVALID_FIELD", p, "نویسهٔ کنترلی یا علامت جهت‌دهی ممنوع دارد.");
+    return null;
+  }
+  if (!multiline && s.indexOf("\n") >= 0) {
+    addIssue(ctx, "INVALID_FIELD", p, "باید تک‌خطی باشد.");
+    return null;
+  }
+  return s;
+}
+
+export function reqText(ctx: Ctx, rec: Rec, key: string, path: string, opts: TextOpts = {}): string {
+  const p = `${path}.${key}`;
+  if (!has(rec, key)) {
+    addIssue(ctx, "MISSING_FIELD", p, "این کلید الزامی است.");
+    return "";
+  }
+  return cleanText(ctx, rec[key], p, opts) ?? "";
+}
+
+/** اختیاری: غایب یا `null` ⇒ `null`. */
+export function optText(ctx: Ctx, rec: Rec, key: string, path: string, opts: TextOpts = {}): string | null {
+  if (!has(rec, key) || rec[key] === null) return null;
+  return cleanText(ctx, rec[key], `${path}.${key}`, opts);
+}
+
+export function reqEnum<T extends string>(ctx: Ctx, rec: Rec, key: string, path: string, list: readonly T[], fallback: T): T {
+  const p = `${path}.${key}`;
+  if (!has(rec, key)) {
+    addIssue(ctx, "MISSING_FIELD", p, "این کلید الزامی است.");
+    return fallback;
+  }
+  const v = rec[key];
+  if (typeof v === "string" && (list as readonly string[]).includes(v)) return v as T;
+  addIssue(ctx, "INVALID_FIELD", p, `مقدار باید یکی از این‌ها باشد: ${list.join("، ")}.`);
+  return fallback;
+}
+
+function readDateValue(ctx: Ctx, v: unknown, p: string): IsoDate | null {
+  if (isValidIsoDate(v)) return v;
+  addIssue(ctx, "INVALID_FIELD", p, "تاریخ باید میلادی و با قالب YYYY-MM-DD (و واقعاً موجود در تقویم) باشد.");
+  return null;
+}
+
+export function reqDate(ctx: Ctx, rec: Rec, key: string, path: string): IsoDate {
+  const p = `${path}.${key}`;
+  if (!has(rec, key)) {
+    addIssue(ctx, "MISSING_FIELD", p, "این کلید الزامی است.");
+    return "1900-01-01";
+  }
+  return readDateValue(ctx, rec[key], p) ?? "1900-01-01";
+}
+
+/** کلید باید **صریحاً** بیاید؛ مقدار `null` مجاز است (برای جلوگیری از «فراموشی بی‌صدا»). */
+export function explicitNullableDate(ctx: Ctx, rec: Rec, key: string, path: string): IsoDate | null {
+  const p = `${path}.${key}`;
+  if (!has(rec, key)) {
+    addIssue(ctx, "MISSING_FIELD", p, "این کلید الزامی است؛ اگر ناشناخته یا بی‌پایان است صریحاً null بگذارید.");
+    return null;
+  }
+  if (rec[key] === null) return null;
+  return readDateValue(ctx, rec[key], p);
+}
+
+export function optDate(ctx: Ctx, rec: Rec, key: string, path: string): IsoDate | null {
+  if (!has(rec, key) || rec[key] === null) return null;
+  return readDateValue(ctx, rec[key], `${path}.${key}`);
+}
+
+export function optUrl(ctx: Ctx, rec: Rec, key: string, path: string): string | null {
+  if (!has(rec, key) || rec[key] === null) return null;
+  const p = `${path}.${key}`;
+  const v = rec[key];
+  if (typeof v !== "string" || v.length > KB_LIMITS.urlChars || !/^https?:\/\/[^\s<>"']+$/i.test(v)) {
+    addIssue(ctx, "INVALID_FIELD", p, "نشانی باید با http:// یا https:// شروع شود، بدون فاصله باشد و حداکثر ۲۰۴۸ نویسه.");
+    return null;
+  }
+  return v;
+}
+
+/** برچسب ماده را به شکل متعارف درمی‌آورد؛ خطا ⇒ مسئله. */
+export function articleLabelValue(ctx: Ctx, v: unknown, p: string): string {
+  if (typeof v !== "string") {
+    addIssue(ctx, "INVALID_FIELD", p, "برچسب ماده باید متن باشد.");
+    return "";
+  }
+  const r = canonicalArticleLabel(v);
+  if (!r.ok) {
+    addIssue(ctx, "INVALID_FIELD", p, r.error.message);
+    return "";
+  }
+  return r.value;
+}
