+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import { MIGRATIONS, migrationChecksum } from "./migrations";
+import { dbDescribe, openTestKb, type TestKb } from "./test-db";
+import { createKbStore } from "./store";
+import { drizzle } from "drizzle-orm/node-postgres";
+
+dbDescribe("legal-kb-store · مهاجرت (پایگاه واقعی)", () => {
+  const opened: TestKb[] = [];
+  const open = async (migrate = true) => {
+    const kb = await openTestKb({ migrate });
+    opened.push(kb);
+    return kb;
+  };
+  afterAll(async () => {
+    for (const kb of opened) await kb.drop();
+  });
+
+  it("پایگاه تازه: همهٔ مهاجرت‌ها اعمال می‌شود و دفتر checksum درست دارد", async () => {
+    const kb = await open(false);
+    const before = await kb.store.migrationStatus();
+    expect(before).toEqual({ ok: true, value: { applied: [], pending: MIGRATIONS.map((m) => m.name) } });
+
+    const r = await kb.store.migrate();
+    expect(r).toEqual({ ok: true, value: { applied: MIGRATIONS.map((m) => m.name), alreadyApplied: [] } });
+
+    const ledger = await kb.raw(`SELECT name, checksum FROM {{schema}}.migration_ledger ORDER BY name`);
+    expect(ledger).toEqual(MIGRATIONS.map((m) => ({ name: m.name, checksum: migrationChecksum(m) })));
+    const after = await kb.store.migrationStatus();
+    expect(after).toEqual({ ok: true, value: { applied: MIGRATIONS.map((m) => m.name), pending: [] } });
+  });
+
+  it("ایدمپوتنت: اجرای دوباره چیزی عوض نمی‌کند", async () => {
+    const kb = await open();
+    const again = await kb.store.migrate();
+    expect(again).toEqual({ ok: true, value: { applied: [], alreadyApplied: MIGRATIONS.map((m) => m.name) } });
+    const ledger = await kb.raw(`SELECT count(*)::int AS n FROM {{schema}}.migration_ledger`);
+    expect(ledger[0]?.["n"]).toBe(MIGRATIONS.length);
+  });
+
+  it("اجرای هم‌زمان ۶ فرایند روی پایگاه تازه: همه موفق، یک بار اعمال", async () => {
+    const kb = await open(false);
+    const results = await Promise.all(Array.from({ length: 6 }, () => kb.store.migrate()));
+    for (const r of results) expect(r.ok).toBe(true);
+    const appliedCounts = results.map((r) => (r.ok ? r.value.applied.length : -1));
+    // دقیقاً یکی اعمال کرده، بقیه «از قبل اعمال‌شده» دیده‌اند
+    expect(appliedCounts.filter((n) => n === MIGRATIONS.length)).toHaveLength(1);
+    expect(appliedCounts.filter((n) => n === 0)).toHaveLength(5);
+    const ledger = await kb.raw(`SELECT count(*)::int AS n FROM {{schema}}.migration_ledger`);
+    expect(ledger[0]?.["n"]).toBe(MIGRATIONS.length);
+  });
+
+  it("دست‌کاری checksum در دفتر: MIGRATION_TAMPERED در همهٔ عملیات؛ هیچ داده‌ای نوشته نمی‌شود", async () => {
+    const kb = await open();
+    await kb.raw(`UPDATE {{schema}}.migration_ledger SET checksum = 'deadbeef'`);
+    for (const r of [await kb.store.migrate(), await kb.store.migrationStatus(), await kb.store.stats(), await kb.store.readCorpus(), await kb.store.insertCorpus({ documents: [], relations: [], rulings: [] })]) {
+      expect(r.ok).toBe(false);
+      if (!r.ok) expect(r.error.code).toBe("MIGRATION_TAMPERED");
+    }
+  });
+
+  it("پایگاه «از آینده» (مهاجرت ناشناخته): MIGRATION_UNKNOWN", async () => {
+    const kb = await open();
+    await kb.raw(`INSERT INTO {{schema}}.migration_ledger (name, checksum) VALUES ('9999_from_the_future', 'x')`);
+    const r = await kb.store.migrate();
+    expect(r.ok).toBe(false);
+    if (!r.ok) expect(r.error.code).toBe("MIGRATION_UNKNOWN");
+    const s = await kb.store.stats();
+    expect(s.ok).toBe(false);
+    if (!s.ok) expect(s.error.code).toBe("MIGRATION_UNKNOWN");
+  });
+
+  it("حفره در دفتر (مهاجرت اول پاک شده): MIGRATION_TAMPERED یا NOT_MIGRATED، هرگز ادامهٔ بی‌صدا", async () => {
+    const kb = await open();
+    await kb.raw(`DELETE FROM {{schema}}.migration_ledger`);
+    const s = await kb.store.stats();
+    expect(s.ok).toBe(false);
+    if (!s.ok) expect(s.error.code).toBe("NOT_MIGRATED");
+  });
+
+  it("شِمای مهاجرت‌نشده: خواندن/نوشتن NOT_MIGRATED (نه خطای خام و نه پایگاه خالی)", async () => {
+    const kb = await open(false);
+    for (const r of [await kb.store.stats(), await kb.store.readCorpus(), await kb.store.insertCorpus({ documents: [], relations: [], rulings: [] })]) {
+      expect(r.ok).toBe(false);
+      if (!r.ok) expect(r.error.code).toBe("NOT_MIGRATED");
+    }
+    const q = await kb.store.resolveCitation({ documentId: "x", article: "1", subpart: null }, "2020-01-01");
+    expect(q.ok).toBe(false);
+    if (!q.ok) expect(q.error.code).toBe("NOT_MIGRATED");
+  });
+
+  it("دو شِمای جدا کاملاً مستقل‌اند", async () => {
+    const a = await open();
+    const b = await open();
+    expect(a.schema).not.toBe(b.schema);
+    const ins = await a.store.insertCorpus({
+      documents: [
+        {
+          id: "only-in-a",
+          kind: "statute",
+          title: "x",
+          shortTitle: null,
+          enactedOn: null,
+          provenance: { sourceName: "s", sourceUrl: null, sourceKind: "secondary", retrievedOn: null },
+          articles: [],
+        },
+      ],
+      relations: [],
+      rulings: [],
+    });
+    expect(ins.ok).toBe(true);
+    const sa = await a.store.stats();
+    const sb = await b.store.stats();
+    expect(sa.ok && sa.value.documents).toBe(1);
+    expect(sb.ok && sb.value.documents).toBe(0);
+  });
+
+  it("مهاجرت به جدول‌ها و شِمای برنامه (public) دست نمی‌زند", async () => {
+    const kb = await open(false);
+    const snapshot = async () => (await kb.raw(`SELECT table_name FROM information_schema.tables WHERE table_schema = 'public' ORDER BY 1`)).map((r) => r["table_name"]);
+    const before = await snapshot();
+    await kb.store.migrate();
+    expect(await snapshot()).toEqual(before);
+    // و همهٔ جدول‌های ما در شِمای خودشان‌اند
+    const tables = (await kb.raw(`SELECT table_name FROM information_schema.tables WHERE table_schema = $1 ORDER BY 1`, [kb.schema])).map((r) => r["table_name"]);
+    expect(tables).toEqual(["article", "article_subpart", "article_version", "document", "migration_ledger", "relation", "ruling", "ruling_cite"]);
+  });
+
+  it("نام شِمای مخرب: ساخت store رد می‌شود و هیچ SQL اجرا نمی‌شود", async () => {
+    const kb = await open();
+    for (const bad of ['x"; DROP SCHEMA public CASCADE; --', "public", "pg_catalog", "Legal", "", "a".repeat(41), "1abc", "a-b", "information_schema"]) {
+      const r = createKbStore(kb.db, { schema: bad });
+      expect(r.ok, bad).toBe(false);
+      if (!r.ok) expect(r.error.code).toBe("INVALID_INPUT");
+    }
+    const alive = await kb.raw(`SELECT 1 AS ok FROM information_schema.schemata WHERE schema_name = 'public'`);
+    expect(alive).toHaveLength(1);
+  });
+
+  describe("نبود دسترسی/اتصال", () => {
+    let kb: TestKb;
+    beforeAll(async () => {
+      kb = await open();
+    });
+    it("اتصال قطع‌شده: DB_ERROR با پیام عمومی؛ رشتهٔ اتصال یا SQL درز نمی‌کند", async () => {
+      const { Pool } = await import("pg");
+      const dead = new Pool({ connectionString: "postgresql://nobody:secret-password@127.0.0.1:1/none", connectionTimeoutMillis: 500 });
+      const store = createKbStore(drizzle(dead), { schema: kb.schema });
+      expect(store.ok).toBe(true);
+      if (!store.ok) return;
+      const r = await store.value.stats();
+      await dead.end();
+      expect(r.ok).toBe(false);
+      if (!r.ok) {
+        expect(r.error.code).toBe("DB_ERROR");
+        expect(JSON.stringify(r.error)).not.toMatch(/secret-password|nobody|127\.0\.0\.1/);
+      }
+    });
+  });
+});
+
+describe("legal-kb-store · مهاجرت (بدون پایگاه)", () => {
+  it("فهرست مهاجرت‌ها مرتب و یکتاست و دستور خالی ندارد", () => {
+    const names = MIGRATIONS.map((m) => m.name);
+    expect(new Set(names).size).toBe(names.length);
+    expect([...names].sort()).toEqual(names);
+    for (const m of MIGRATIONS) {
+      expect(m.name).toMatch(/^\d{4}_[a-z0-9_]+$/);
+      expect(m.statements.length).toBeGreaterThan(0);
+      for (const s of m.statements) expect(s.trim()).not.toBe("");
+    }
+  });
+});
diff --git a/src/modules/legal-kb-store/migrate.ts b/src/modules/legal-kb-store/migrate.ts
new file mode 100644
index 0000000..37f4332
--- /dev/null
+++ b/src/modules/legal-kb-store/migrate.ts
@@ -0,0 +1,121 @@
+/**
+ * اجرای مهاجرت‌ها (داخلی؛ از `createKbStore(...).migrate()` در دسترس است).
+ *
+ * ضمانت‌ها:
+ *  - همه‌چیز در **یک تراکنش** و زیر قفل مشورتی؛ اجرای هم‌زمان دو فرایند امن است (دومی منتظر می‌ماند و چیزی برای اعمال نمی‌بیند).
+ *  - checksum مهاجرت‌های اعمال‌شده با کد سنجیده می‌شود (ویرایش مهاجرتِ قدیمی = خطا)؛ پایگاهِ «از آینده» و «حفره» رد می‌شود.
+ *  - اگر خطایی رخ دهد هیچ تغییری باقی نمی‌ماند (DDL پستگرس تراکنشی است).
+ */
+import { sql } from "drizzle-orm";
+import { StoreAbort, toStoreError } from "./errors";
+import { MIGRATIONS, migrationChecksum, renderStatement, type Migration } from "./migrations";
+import { tableRef } from "./naming";
+import type { KbDatabase, KbExecutor, MigrationReport, MigrationStatus, StoreResult } from "./types";
+
+export type LedgerRow = Readonly<{ name: string; checksum: string }>;
+
+async function readLedger(ex: KbExecutor, schema: string): Promise<readonly LedgerRow[]> {
+  const res = await ex.execute(sql`SELECT name, checksum FROM ${tableRef(schema, "migration_ledger")} ORDER BY name`);
+  return res.rows.map((r) => {
+    const name = r["name"];
+    const checksum = r["checksum"];
+    if (typeof name !== "string" || typeof checksum !== "string") {
+      throw new StoreAbort({ code: "CORRUPT_DATA", message: "دفتر مهاجرت‌ها (migration_ledger) شکل نادرستی دارد." });
+    }
+    return { name, checksum };
+  });
+}
+
+/**
+ * دفتر را با فهرست کد مقایسه می‌کند. نتیجه: نام‌های اعمال‌شده و معلق.
+ * خطا (پرتاب StoreAbort): ناشناخته، checksum ناهمخوان، یا حفره (مهاجرتِ بعدی اعمال شده ولی قبلی نه).
+ */
+export function reconcile(ledger: readonly LedgerRow[], migrations: readonly Migration[] = MIGRATIONS): MigrationStatus {
+  const known = new Map(migrations.map((m) => [m.name, m]));
+  for (const row of ledger) {
+    if (!known.has(row.name)) {
+      throw new StoreAbort({
+        code: "MIGRATION_UNKNOWN",
+        message: `پایگاه مهاجرت «${row.name}» را دارد که این نسخهٔ برنامه نمی‌شناسد (پایگاه از نسخهٔ جدیدتری است)؛ برنامه را به‌روز کنید.`,
+      });
+    }
+  }
+  const byName = new Map(ledger.map((r) => [r.name, r.checksum]));
+  const applied: string[] = [];
+  const pending: string[] = [];
+  for (const m of migrations) {
+    const stored = byName.get(m.name);
+    if (stored === undefined) {
+      pending.push(m.name);
+      continue;
+    }
+    if (pending.length > 0) {
+      throw new StoreAbort({ code: "MIGRATION_TAMPERED", message: `مهاجرت «${m.name}» اعمال شده ولی مهاجرت پیش از آن (${pending[0]}) نه؛ دفتر مهاجرت‌ها دست‌کاری شده است.` });
+    }
+    if (stored !== migrationChecksum(m)) {
+      throw new StoreAbort({ code: "MIGRATION_TAMPERED", message: `محتوای مهاجرت «${m.name}» پس از اعمال تغییر کرده است (checksum ناهمخوان). مهاجرت اعمال‌شده هرگز ویرایش نمی‌شود؛ مهاجرت تازه بسازید.` });
+    }
+    applied.push(m.name);
+  }
+  return { applied, pending };
+}
+
+export async function migrate(db: KbDatabase, schema: string): Promise<StoreResult<MigrationReport>> {
+  try {
+    const report = await db.transaction(async (tx) => {
+      // قفل سراسری فقط برای راه‌اندازی/مهاجرت: CREATE EXTENSION هم‌زمان در پستگرس مسابقه دارد.
+      await tx.execute(sql`SELECT pg_advisory_xact_lock(hashtextextended(${"legal-kb-store:migrate"}, 0))`);
+      // btree_gist برای قید EXCLUDE روی (متن = ، بازه &&). از پایگاه‌های «trusted» است (مالک پایگاه کافی است).
+      await tx.execute(sql`CREATE EXTENSION IF NOT EXISTS btree_gist`);
+      await tx.execute(sql`CREATE SCHEMA IF NOT EXISTS ${sql.identifier(schema)}`);
+      await tx.execute(sql`CREATE TABLE IF NOT EXISTS ${tableRef(schema, "migration_ledger")} (
+        name text NOT NULL,
+        checksum text NOT NULL,
+        applied_at timestamptz NOT NULL DEFAULT now(),
+        CONSTRAINT migration_ledger_pk PRIMARY KEY (name)
+      )`);
+
+      const status = reconcile(await readLedger(tx, schema));
+      for (const m of MIGRATIONS.filter((x) => status.pending.includes(x.name))) {
+        for (const statement of m.statements) await tx.execute(sql.raw(renderStatement(statement, schema)));
+        await tx.execute(sql`INSERT INTO ${tableRef(schema, "migration_ledger")} (name, checksum) VALUES (${m.name}, ${migrationChecksum(m)})`);
+      }
+      return { applied: status.pending, alreadyApplied: status.applied } satisfies MigrationReport;
+    });
+    return { ok: true, value: report };
+  } catch (e) {
+    return { ok: false, error: toStoreError(e) };
+  }
+}
+
+/** فقط‌خواندنی: چه چیزی اعمال شده و چه چیزی معلق است. شِمای ناموجود = همه معلق (خطا نیست). */
+export async function migrationStatus(db: KbDatabase, schema: string): Promise<StoreResult<MigrationStatus>> {
+  try {
+    const status = await db.transaction(
+      async (tx) => {
+        const exists = await tx.execute(sql`SELECT to_regclass(${`${JSON.stringify(schema)}.migration_ledger`}) IS NOT NULL AS present`);
+        if (exists.rows[0]?.["present"] !== true) return { applied: [], pending: MIGRATIONS.map((m) => m.name) } satisfies MigrationStatus;
+        return reconcile(await readLedger(tx, schema));
+      },
+      { accessMode: "read only" },
+    );
+    return { ok: true, value: status };
+  } catch (e) {
+    return { ok: false, error: toStoreError(e) };
+  }
+}
+
+/**
+ * سپر هر عملیات: برنامه فقط روی پایگاهی کار می‌کند که **دقیقاً** با مهاجرت‌های همین کد همخوان است.
+ * (وگرنه کوئری‌ها ممکن است بی‌صدا روی شمای قدیمی/ناسازگار اجرا شوند.) داخل تراکنشِ خود عملیات صدا زده می‌شود.
+ */
+export async function assertCurrent(ex: KbExecutor, schema: string): Promise<void> {
+  const exists = await ex.execute(sql`SELECT to_regclass(${`${JSON.stringify(schema)}.migration_ledger`}) IS NOT NULL AS present`);
+  if (exists.rows[0]?.["present"] !== true) {
+    throw new StoreAbort({ code: "NOT_MIGRATED", message: "پایگاه دانش هنوز مهاجرت نشده است؛ ابتدا migrate() را اجرا کنید." });
+  }
+  const status = reconcile(await readLedger(ex, schema));
+  if (status.pending.length > 0) {
+    throw new StoreAbort({ code: "NOT_MIGRATED", message: `مهاجرت معلق: ${status.pending.join("، ")}؛ ابتدا migrate() را اجرا کنید.` });
+  }
+}
diff --git a/src/modules/legal-kb-store/migrations.ts b/src/modules/legal-kb-store/migrations.ts
new file mode 100644
index 0000000..a6b7be3
--- /dev/null
+++ b/src/modules/legal-kb-store/migrations.ts
@@ -0,0 +1,201 @@
+/**
+ * مهاجرت‌های شِمای پایگاه دانش — SQL دست‌نویس (🔴 ناحیهٔ پرریسک: بازبینی مالک معماری).
+ *
+ * چرا SQL دست‌نویس و نه `drizzle-kit push`؟ قیدهای اصلیِ این مدل را drizzle-kit نمی‌تواند بیان کند:
+ *   • `EXCLUDE USING gist` (نبودِ هم‌پوشانی بازهٔ اعتبار نسخه‌ها — خودِ پایگاه، نه فقط برنامه)،
+ *   • ستون تولیدشدهٔ `daterange` نیم‌باز، DOMAINهای بازبینی نویسه، و ایندکس یکتای عبارتی.
+ * همچنین همهٔ جدول‌ها در **شِمای جدا** (`legal_kb`) هستند تا `drizzle-kit push` (که فقط `public` را می‌بیند) هرگز
+ * آن‌ها را «اضافی» نداند و حذف نکند.
+ *
+ * قواعد:
+ *  1. مهاجرتِ اعمال‌شده **هرگز ویرایش نمی‌شود**؛ تغییر = مهاجرت تازه (`0002_…`). تست، checksum را قفل کرده است.
+ *  2. هر مهاجرت فهرستی از دستورهای جدا است (نه یک رشتهٔ چنددستوری) و در **یک تراکنش** اجرا می‌شود.
+ *  3. `{{schema}}` هنگام اجرا با نام نقل‌قول‌شدهٔ شِما (پس از اعتبارسنجی فهرست‌سفید) جایگزین می‌شود.
+ *  4. قیدهای پایگاه **هم‌ارز یا ملایم‌تر** از `loadCorpus` هستند و هرگز سخت‌گیرتر نیستند؛ دادهٔ معتبر هرگز به‌خاطر قید رد نمی‌شود،
+ *     ولی دادهٔ نامعتبری که از مسیر دیگر (psql، اسکریپت) بیاید، باز هم رد می‌شود (دفاع در عمق).
+ */
+import { createHash } from "node:crypto";
+
+export type Migration = Readonly<{ name: string; statements: readonly string[] }>;
+
+const S = "{{schema}}";
+
+/** نویسهٔ کنترلی، علامت‌های جهت‌دهی Trojan-Source و BOM — همان فهرست `reader.ts` در legal-kb-schema (NUL در متن پستگرس ممکن نیست). */
+const FORBIDDEN = String.raw`[\u0001-\u0008\u000B\u000C\u000E-\u001F\u007F-\u009F\u202A-\u202E\u2066-\u2069\uFEFF]`;
+
+/** ستون‌های منبع و بازبینی (هر رکورد حقوقی منبع و وضعیت بازبینی دارد). */
+const provenanceColumns = `
+  source_name ${S}.line_text NOT NULL,
+  source_url text,
+  source_kind text NOT NULL,
+  retrieved_on ${S}.iso_date,
+  review_status text NOT NULL DEFAULT 'pending-legal-review',
+  reviewed_by ${S}.line_text,
+  reviewed_on ${S}.iso_date`;
+
+const provenanceConstraints = (t: string) => `
+  CONSTRAINT ${t}_source_name_len_ck CHECK (char_length(source_name) <= 300),
+  CONSTRAINT ${t}_source_url_ck CHECK (source_url IS NULL OR (char_length(source_url) <= 2048 AND source_url ~* ${String.raw`'^https?://[^ \t\r\n\f\v<>"'']+$'`})),
+  CONSTRAINT ${t}_source_kind_ck CHECK (source_kind IN ('official', 'secondary')),
+  CONSTRAINT ${t}_review_status_ck CHECK (review_status IN ('pending-legal-review', 'legally-verified')),
+  CONSTRAINT ${t}_reviewed_by_len_ck CHECK (char_length(reviewed_by) <= 200),
+  CONSTRAINT ${t}_review_consistent_ck CHECK (
+    (review_status = 'pending-legal-review' AND reviewed_by IS NULL AND reviewed_on IS NULL)
+    OR (review_status = 'legally-verified' AND reviewed_by IS NOT NULL AND reviewed_on IS NOT NULL))`;
+
+const m0001: Migration = {
+  name: "0001_init",
+  statements: [
+    // ───────── DOMAINها: قید نویسه و تاریخ یک‌بار و برای همهٔ ستون‌ها ─────────
+    `CREATE DOMAIN ${S}.iso_date AS date
+       CONSTRAINT iso_date_range_ck CHECK (VALUE BETWEEN DATE '1800-01-01' AND DATE '2200-12-31')`,
+    `CREATE DOMAIN ${S}.line_text AS text
+       CONSTRAINT line_text_ck CHECK (
+         VALUE <> '' AND char_length(VALUE) <= 500 AND position(E'\\n' in VALUE) = 0 AND VALUE !~ '${FORBIDDEN}')`,
+    `CREATE DOMAIN ${S}.body_text AS text
+       CONSTRAINT body_text_ck CHECK (
+         VALUE <> '' AND char_length(VALUE) <= 200000 AND position(E'\\r' in VALUE) = 0 AND VALUE !~ '${FORBIDDEN}')`,
+
+    // ───────── سند ─────────
+    `CREATE TABLE ${S}.document (
+       seq bigint NOT NULL,
+       id text NOT NULL,
+       kind text NOT NULL,
+       title ${S}.line_text NOT NULL,
+       short_title ${S}.line_text,
+       enacted_on ${S}.iso_date,${provenanceColumns},
+       CONSTRAINT document_pk PRIMARY KEY (id),
+       CONSTRAINT document_seq_uq UNIQUE (seq),
+       CONSTRAINT document_seq_ck CHECK (seq > 0),
+       CONSTRAINT document_id_ck CHECK (char_length(id) <= 64 AND id ~ '^[a-z0-9]+(-[a-z0-9]+)*$'),
+       CONSTRAINT document_kind_ck CHECK (kind IN ('constitution', 'statute', 'regulation', 'directive', 'approval')),
+       CONSTRAINT document_title_len_ck CHECK (char_length(title) <= 300),
+       CONSTRAINT document_short_title_len_ck CHECK (char_length(short_title) <= 100),${provenanceConstraints("document")}
+     )`,
+
+    // ───────── ماده: شناسه = (سند، برچسب متعارف)؛ برچسب باید با (شماره، مکرر) بخواند ─────────
+    // article_number: ۰ = «واحده»، ۱…۹۹۹۹۹ = شماره؛ article_repeat: ۰ = بدون مکرر، ۱ = «مکرر»، n≥۲ = «مکرر n».
+    `CREATE TABLE ${S}.article (
+       document_id text NOT NULL,
+       label text NOT NULL,
+       article_number integer NOT NULL,
+       article_repeat integer NOT NULL DEFAULT 0,
+       CONSTRAINT article_pk PRIMARY KEY (document_id, label),
+       CONSTRAINT article_order_uq UNIQUE (document_id, article_number, article_repeat),
+       CONSTRAINT article_document_fk FOREIGN KEY (document_id) REFERENCES ${S}.document (id),
+       CONSTRAINT article_number_ck CHECK (article_number BETWEEN 0 AND 99999),
+       CONSTRAINT article_repeat_ck CHECK (article_repeat BETWEEN 0 AND 99 AND (article_number > 0 OR article_repeat = 0)),
+       CONSTRAINT article_label_matches_ck CHECK (
+         label = CASE
+           WHEN article_number = 0 THEN 'واحده'
+           WHEN article_repeat = 0 THEN article_number::text
+           WHEN article_repeat = 1 THEN article_number::text || ' مکرر'
+           ELSE article_number::text || ' مکرر ' || article_repeat::text
+         END)
+     )`,
+
+    // ───────── نسخهٔ زمانی: بازهٔ نیم‌باز [valid_from, valid_to) و قید نبود هم‌پوشانی در خودِ پایگاه ─────────
+    `CREATE TABLE ${S}.article_version (
+       document_id text NOT NULL,
+       article_label text NOT NULL,
+       valid_from ${S}.iso_date NOT NULL,
+       valid_to ${S}.iso_date,
+       valid_during daterange GENERATED ALWAYS AS (daterange(valid_from, valid_to, '[)')) STORED,
+       body ${S}.body_text NOT NULL,${provenanceColumns},
+       CONSTRAINT article_version_pk PRIMARY KEY (document_id, article_label, valid_from),
+       CONSTRAINT article_version_article_fk FOREIGN KEY (document_id, article_label) REFERENCES ${S}.article (document_id, label),
+       CONSTRAINT article_version_interval_ck CHECK (valid_to IS NULL OR valid_to > valid_from),
+       CONSTRAINT article_version_no_overlap EXCLUDE USING gist (document_id WITH =, article_label WITH =, valid_during WITH &&),${provenanceConstraints("article_version")}
+     )`,
+
+    // ───────── تبصره/بند ─────────
+    `CREATE TABLE ${S}.article_subpart (
+       document_id text NOT NULL,
+       article_label text NOT NULL,
+       valid_from ${S}.iso_date NOT NULL,
+       ordinal integer NOT NULL,
+       kind text NOT NULL,
+       label text NOT NULL,
+       body ${S}.body_text NOT NULL,
+       CONSTRAINT article_subpart_pk PRIMARY KEY (document_id, article_label, valid_from, kind, label),
+       CONSTRAINT article_subpart_order_uq UNIQUE (document_id, article_label, valid_from, ordinal),
+       CONSTRAINT article_subpart_version_fk FOREIGN KEY (document_id, article_label, valid_from)
+         REFERENCES ${S}.article_version (document_id, article_label, valid_from),
+       CONSTRAINT article_subpart_kind_ck CHECK (kind IN ('note', 'clause')),
+       CONSTRAINT article_subpart_label_ck CHECK (label ~ '^([1-9][0-9]{0,2}|[آابپتثجچحخدذرزژسشصضطظعغفقکگلمنوهی]{1,6})$'),
+       CONSTRAINT article_subpart_ordinal_ck CHECK (ordinal BETWEEN 0 AND 99)
+     )`,
+
+    // ───────── رابطه ─────────
+    // کلید ارجاع مرکب با MATCH SIMPLE: وقتی ماده تهی است (رابطه با کل سند) فقط FK سند اعمال می‌شود.
+    `CREATE TABLE ${S}.relation (
+       seq bigint NOT NULL,
+       type text NOT NULL,
+       from_document_id text NOT NULL,
+       from_article text,
+       to_document_id text NOT NULL,
+       to_article text,
+       effective_from ${S}.iso_date,
+       note ${S}.body_text,${provenanceColumns},
+       CONSTRAINT relation_pk PRIMARY KEY (seq),
+       CONSTRAINT relation_seq_ck CHECK (seq > 0),
+       CONSTRAINT relation_type_ck CHECK (type IN ('amends', 'repeals', 'replaces', 'refers-to', 'implements', 'interprets')),
+       CONSTRAINT relation_from_document_fk FOREIGN KEY (from_document_id) REFERENCES ${S}.document (id),
+       CONSTRAINT relation_from_article_fk FOREIGN KEY (from_document_id, from_article) REFERENCES ${S}.article (document_id, label),
+       CONSTRAINT relation_to_document_fk FOREIGN KEY (to_document_id) REFERENCES ${S}.document (id),
+       CONSTRAINT relation_to_article_fk FOREIGN KEY (to_document_id, to_article) REFERENCES ${S}.article (document_id, label),
+       CONSTRAINT relation_not_self_ck CHECK (NOT (from_document_id = to_document_id AND from_article IS NOT DISTINCT FROM to_article)),
+       CONSTRAINT relation_note_len_ck CHECK (char_length(note) <= 2000),${provenanceConstraints("relation")}
+     )`,
+    `CREATE UNIQUE INDEX relation_dedupe_uq ON ${S}.relation
+       (type, from_document_id, coalesce(from_article, ''), to_document_id, coalesce(to_article, ''), coalesce(effective_from, DATE '9999-12-31'))`,
+    `CREATE INDEX relation_from_ix ON ${S}.relation (from_document_id, from_article)`,
+    `CREATE INDEX relation_to_ix ON ${S}.relation (to_document_id, to_article)`,
+
+    // ───────── رأی ─────────
+    `CREATE TABLE ${S}.ruling (
+       seq bigint NOT NULL,
+       id text NOT NULL,
+       kind text NOT NULL,
+       number ${S}.line_text NOT NULL,
+       issuer ${S}.line_text NOT NULL,
+       issued_on ${S}.iso_date NOT NULL,
+       title ${S}.line_text,
+       body ${S}.body_text NOT NULL,${provenanceColumns},
+       CONSTRAINT ruling_pk PRIMARY KEY (id),
+       CONSTRAINT ruling_seq_uq UNIQUE (seq),
+       CONSTRAINT ruling_seq_ck CHECK (seq > 0),
+       CONSTRAINT ruling_id_ck CHECK (char_length(id) <= 64 AND id ~ '^[a-z0-9]+(-[a-z0-9]+)*$'),
+       CONSTRAINT ruling_kind_ck CHECK (kind IN ('unity-ruling', 'constitutional-opinion', 'advisory-opinion', 'judgment')),
+       CONSTRAINT ruling_number_len_ck CHECK (char_length(number) <= 100),
+       CONSTRAINT ruling_issuer_len_ck CHECK (char_length(issuer) <= 300),
+       CONSTRAINT ruling_title_len_ck CHECK (char_length(title) <= 300),${provenanceConstraints("ruling")}
+     )`,
+    `CREATE TABLE ${S}.ruling_cite (
+       ruling_id text NOT NULL,
+       ordinal integer NOT NULL,
+       document_id text NOT NULL,
+       article_label text,
+       CONSTRAINT ruling_cite_pk PRIMARY KEY (ruling_id, ordinal),
+       CONSTRAINT ruling_cite_ruling_fk FOREIGN KEY (ruling_id) REFERENCES ${S}.ruling (id),
+       CONSTRAINT ruling_cite_document_fk FOREIGN KEY (document_id) REFERENCES ${S}.document (id),
+       CONSTRAINT ruling_cite_article_fk FOREIGN KEY (document_id, article_label) REFERENCES ${S}.article (document_id, label),
+       CONSTRAINT ruling_cite_ordinal_ck CHECK (ordinal BETWEEN 0 AND 199)
+     )`,
+    `CREATE UNIQUE INDEX ruling_cite_dedupe_uq ON ${S}.ruling_cite (ruling_id, document_id, coalesce(article_label, ''))`,
+    `CREATE INDEX ruling_cite_target_ix ON ${S}.ruling_cite (document_id, article_label)`,
+  ],
+};
+
+/** فهرست مرتب مهاجرت‌ها؛ فقط به انتها افزوده می‌شود. */
+export const MIGRATIONS: readonly Migration[] = [m0001];
+
+/** SHA-256 نام و دستورها؛ هر تغییر (حتی یک فاصله) در مهاجرتِ اعمال‌شده با «MIGRATION_TAMPERED» دیده می‌شود. */
+export function migrationChecksum(m: Migration): string {
+  return createHash("sha256").update(JSON.stringify([m.name, m.statements])).digest("hex");
+}
+
+/** جایگزینی `{{schema}}` با نام نقل‌قول‌شده. `schema` باید پیشتر با `parseSchemaName` تأیید شده باشد. */
+export function renderStatement(statement: string, schema: string): string {
+  return statement.split(S).join(`"${schema}"`);
+}
