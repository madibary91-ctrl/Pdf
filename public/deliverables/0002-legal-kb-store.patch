+
+dbDescribe("legal-kb-store · دیده‌شدن اتمی (تصویر یکدست)", () => {
+  it("خواننده‌ها در حین یک درج بزرگ یا هیچ‌چیز می‌بینند یا همه‌چیز (نه نیمه‌کاره)", async () => {
