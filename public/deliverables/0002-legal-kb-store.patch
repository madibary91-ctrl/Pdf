index 0000000..e4f827b
--- /dev/null
+++ b/src/modules/legal-kb-store/rows.test.ts
@@ -0,0 +1,88 @@
+/** خواننده‌های ردیف (بدون پایگاه): ردیفِ ناهمخوان با مدل = CorruptRowError، نه مقدار پیش‌فرض و نه حدس. */
+import { describe, expect, it } from "vitest";
+import { CorruptRowError } from "./errors";
+import { int, isoDate, isoDateOrNull, readProvenance, readSubpart, readVersionRow, str, strOrNull } from "./rows";
+
+const throwsCorrupt = (fn: () => unknown) => expect(fn).toThrow(CorruptRowError);
+
+const baseProv = {
+  source_name: "منبع",
+  source_url: null,
+  source_kind: "secondary",
+  retrieved_on: "2025-01-10",
+  review_status: "pending-legal-review",
+  reviewed_by: null,
+  reviewed_on: null,
+};
+
+describe("rows: نگهبان‌های نوع ستون", () => {
+  it("str: فقط رشته", () => {
+    expect(str({ a: "x" }, "a")).toBe("x");
+    expect(str({ a: "" }, "a")).toBe("");
+    for (const bad of [null, undefined, 1, true, {}, [], new Date()]) throwsCorrupt(() => str({ a: bad }, "a"));
+    throwsCorrupt(() => str({}, "missing"));
+  });
+  it("strOrNull: رشته یا null، نه undefined", () => {
+    expect(strOrNull({ a: null }, "a")).toBeNull();
+    expect(strOrNull({ a: "x" }, "a")).toBe("x");
+    for (const bad of [undefined, 1, {}]) throwsCorrupt(() => strOrNull({ a: bad }, "a"));
+  });
+  it("int: فقط عدد صحیح (نه رشته، نه اعشاری، نه NaN، نه bigint)", () => {
+    expect(int({ a: 0 }, "a")).toBe(0);
+    expect(int({ a: -5 }, "a")).toBe(-5);
+    for (const bad of ["1", 1.5, NaN, Infinity, null, undefined, BigInt(1)]) throwsCorrupt(() => int({ a: bad }, "a"));
+  });
+  it("isoDate / isoDateOrNull: فقط تاریخ میلادی معتبر ISO", () => {
+    expect(isoDate({ a: "2024-02-29" }, "a")).toBe("2024-02-29");
+    expect(isoDateOrNull({ a: null }, "a")).toBeNull();
+    for (const bad of ["2023-02-29", "1403-01-01", "2024-1-1", "", null, undefined, new Date("2020-01-01")]) throwsCorrupt(() => isoDate({ a: bad }, "a"));
+    for (const bad of ["x", undefined, 5]) throwsCorrupt(() => isoDateOrNull({ a: bad }, "a"));
+  });
+});
+
+describe("rows: readProvenance", () => {
+  it("تأییدنشده و تأییدشدهٔ سازگار", () => {
+    expect(readProvenance(baseProv)).toEqual({
+      sourceName: "منبع",
+      sourceUrl: null,
+      sourceKind: "secondary",
+      retrievedOn: "2025-01-10",
+      review: { status: "pending-legal-review", reviewedBy: null, reviewedOn: null },
+    });
+    const v = readProvenance({ ...baseProv, source_kind: "official", review_status: "legally-verified", reviewed_by: "علی", reviewed_on: "2025-02-01" });
+    expect(v.review).toEqual({ status: "legally-verified", reviewedBy: "علی", reviewedOn: "2025-02-01" });
+  });
+  it("وضعیت بازبینی ناسازگار هرگز verified نمی‌شود", () => {
+    throwsCorrupt(() => readProvenance({ ...baseProv, review_status: "legally-verified" }));
+    throwsCorrupt(() => readProvenance({ ...baseProv, review_status: "legally-verified", reviewed_by: "علی" }));
+    throwsCorrupt(() => readProvenance({ ...baseProv, review_status: "legally-verified", reviewed_on: "2025-02-01" }));
+    throwsCorrupt(() => readProvenance({ ...baseProv, reviewed_by: "علی" }));
+    throwsCorrupt(() => readProvenance({ ...baseProv, reviewed_on: "2025-02-01" }));
+  });
+  it("مقدار شمارشی ناشناخته", () => {
+    throwsCorrupt(() => readProvenance({ ...baseProv, review_status: "approved" }));
+    throwsCorrupt(() => readProvenance({ ...baseProv, source_kind: "wiki" }));
+    throwsCorrupt(() => readProvenance({ ...baseProv, retrieved_on: "1403-01-01" }));
+  });
+});
+
+describe("rows: readSubpart و readVersionRow", () => {
+  it("تبصره/بند", () => {
+    expect(readSubpart({ kind: "clause", label: "الف", body: "متن" })).toEqual({ kind: "clause", label: "الف", text: "متن" });
+    throwsCorrupt(() => readSubpart({ kind: "item", label: "1", body: "x" }));
+    throwsCorrupt(() => readSubpart({ kind: "note", label: 1, body: "x" }));
+  });
+  it("نسخه: فیلدها و تبصره‌ها منتقل می‌شوند؛ تاریخ نامعتبر رد", () => {
+    const subs = [{ kind: "note" as const, label: "1", text: "t" }];
+    expect(readVersionRow({ ...baseProv, valid_from: "2000-01-01", valid_to: null, body: "متن" }, subs)).toEqual({
+      validFrom: "2000-01-01",
+      validTo: null,
+      text: "متن",
+      subparts: subs,
+      provenance: readProvenance(baseProv),
+    });
+    throwsCorrupt(() => readVersionRow({ ...baseProv, valid_from: "x", valid_to: null, body: "m" }, []));
+    throwsCorrupt(() => readVersionRow({ ...baseProv, valid_from: "2000-01-01", valid_to: "bad", body: "m" }, []));
+    throwsCorrupt(() => readVersionRow({ ...baseProv, valid_from: "2000-01-01", valid_to: null, body: 5 }, []));
+  });
+});
diff --git a/src/modules/legal-kb-store/rows.ts b/src/modules/legal-kb-store/rows.ts
new file mode 100644
index 0000000..f45d28f
--- /dev/null
+++ b/src/modules/legal-kb-store/rows.ts
@@ -0,0 +1,96 @@
+/**
+ * خواندن ردیف‌ها (داخلی). ردیفِ ناهمخوان با مدل = `CorruptRowError` (→ CORRUPT_DATA)، نه حدس و نه مقدار پیش‌فرض.
+ * تاریخ‌ها همیشه با `to_char` به رشتهٔ ISO درمی‌آیند (نه `Date` جاوااسکریپت): منطقهٔ زمانی هرگز وارد نمی‌شود.
+ */
+import { sql, type SQL } from "drizzle-orm";
+import { isValidIsoDate, type ArticleVersion, type IsoDate, type Provenance, type ReviewStatus, type SourceKind, type Subpart, type SubpartKind } from "@/modules/legal-kb-schema";
+import { CorruptRowError } from "./errors";
+
+export type Row = Readonly<Record<string, unknown>>;
+
+export function str(r: Row, k: string): string {
+  const v = r[k];
+  if (typeof v !== "string") throw new CorruptRowError(`ستون ${k}`);
+  return v;
+}
+
+export function strOrNull(r: Row, k: string): string | null {
+  const v = r[k];
+  if (v === null) return null;
+  if (typeof v !== "string") throw new CorruptRowError(`ستون ${k}`);
+  return v;
+}
+
+export function int(r: Row, k: string): number {
+  const v = r[k];
+  if (typeof v !== "number" || !Number.isInteger(v)) throw new CorruptRowError(`ستون ${k}`);
+  return v;
+}
+
+export function isoDate(r: Row, k: string): IsoDate {
+  const v = r[k];
+  if (!isValidIsoDate(v)) throw new CorruptRowError(`ستون ${k}`);
+  return v;
+}
+
+export function isoDateOrNull(r: Row, k: string): IsoDate | null {
+  return r[k] === null ? null : isoDate(r, k);
+}
+
+const ISO = (col: string) => `to_char(${col}, 'YYYY-MM-DD')`;
+
+/** ستون‌های منبع/بازبینی برای SELECT. `alias` ثابت درون کد است (هرگز ورودی کاربر). */
+export function provenanceSelect(alias: string): SQL {
+  const p = alias === "" ? "" : `${alias}.`;
+  return sql.raw(
+    [
+      `${p}source_name`,
+      `${p}source_url`,
+      `${p}source_kind`,
+      `${ISO(`${p}retrieved_on`)} AS retrieved_on`,
+      `${p}review_status`,
+      `${p}reviewed_by`,
+      `${ISO(`${p}reviewed_on`)} AS reviewed_on`,
+    ].join(", "),
+  );
+}
+
+export const DATE_OUT = (col: string, as: string): SQL => sql.raw(`${ISO(col)} AS ${as}`);
+
+function oneOf<T extends string>(value: string, allowed: readonly T[], what: string): T {
+  const hit = allowed.find((a) => a === value);
+  if (hit === undefined) throw new CorruptRowError(`مقدار ${what}`);
+  return hit;
+}
+
+export function readProvenance(r: Row): Provenance {
+  const status = oneOf<ReviewStatus>(str(r, "review_status"), ["pending-legal-review", "legally-verified"], "review_status");
+  const reviewedBy = strOrNull(r, "reviewed_by");
+  const reviewedOn = isoDateOrNull(r, "reviewed_on");
+  // همان قاعدهٔ loadCorpus، این‌جا هم سنجیده می‌شود: کوئری‌های نقطه‌ای از loadCorpus نمی‌گذرند و
+  // «تأییدشده» بدون بازبین (قید برداشته‌شده یا SQL دستی) هرگز نباید `verified: true` شود.
+  const consistent = status === "legally-verified" ? reviewedBy !== null && reviewedOn !== null : reviewedBy === null && reviewedOn === null;
+  if (!consistent) throw new CorruptRowError("وضعیت بازبینی ناسازگار با نام/تاریخ بازبین");
+  return {
+    sourceName: str(r, "source_name"),
+    sourceUrl: strOrNull(r, "source_url"),
+    sourceKind: oneOf<SourceKind>(str(r, "source_kind"), ["official", "secondary"], "source_kind"),
+    retrievedOn: isoDateOrNull(r, "retrieved_on"),
+    review: { status, reviewedBy, reviewedOn },
+  };
+}
+
+export function readSubpart(r: Row): Subpart {
+  return { kind: oneOf<SubpartKind>(str(r, "kind"), ["note", "clause"], "kind"), label: str(r, "label"), text: str(r, "body") };
+}
+
+/** ستون‌های لازم برای ساخت `ArticleVersion` (به‌جز تبصره‌ها): validFrom, validTo, body, provenance. */
+export function readVersionRow(r: Row, subparts: readonly Subpart[]): ArticleVersion {
+  return {
+    validFrom: isoDate(r, "valid_from"),
+    validTo: isoDateOrNull(r, "valid_to"),
+    text: str(r, "body"),
+    subparts,
+    provenance: readProvenance(r),
+  };
+}
